digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.50,
    ranksep=0.88,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Component Diagram - Reservation to Settlement Runtime Collaboration"
  ];

  node [shape=component, style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=8.8, margin="0.10,0.06"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=7.8];

  subgraph cluster_reservation {
    label="Reservation";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReservationCheckInService [label="ReservationCheckInService"];
    ReservationTableAssignmentService [label="ReservationTableAssignmentService"];
    ReservationSeatingMediator [label="ReservationSeatingMediator"];
    ReservationTableAssignmentRepository [label="ReservationTableAssignmentRepository\ninterface"];
  }

  subgraph cluster_ordering {
    label="Ordering";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    OrdersController [label="OrdersController\n/api/orders"];
    OrderingService [label="OrderingService"];
    OrderRepository [label="OrderRepository\ninterface"];
    RemoteKitchenOrderRoutingClient [label="RemoteKitchenOrderRoutingClient"];
  }

  subgraph cluster_kitchen {
    label="Kitchen";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    KitchenIntegrationController [label="KitchenIntegrationController\n/internal/kitchen"];
    KitchenOrderRoutingService [label="KitchenOrderRoutingService"];
    KitchenTicketItemWorkflowService [label="KitchenTicketItemWorkflowService"];
    RemoteInventoryConsumptionClient [label="RemoteInventoryConsumptionClient"];
  }

  subgraph cluster_billing {
    label="Billing";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    BillsController [label="BillsController\n/api/bills"];
    BillingBillCreationService [label="BillingBillCreationService"];
    BillingPaymentService [label="BillingPaymentService"];
    PaymentGateway [label="PaymentGateway\ninterface"];
    CashPaymentGateway [label="CashPaymentGateway"];
    ExternalReferencePaymentGateway [label="ExternalReferencePaymentGateway"];
  }

  subgraph cluster_async {
    label="Asynchronous Support";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    RabbitMqEventPublisher [label="RabbitMqEventPublisher"];
    ReportingProjectionConsumer [label="ReportingProjectionConsumer\nRabbit listener"];
    NotificationRequestedConsumer [label="NotificationRequestedConsumer\nRabbit listener"];
    AuditRecordingRequestedConsumer [label="AuditRecordingRequestedConsumer\nRabbit listener"];
  }

  ReservationCheckInService -> ReservationSeatingMediator;
  ReservationSeatingMediator -> ReservationTableAssignmentService;
  ReservationTableAssignmentService -> ReservationTableAssignmentRepository;

  OrdersController -> OrderingService;
  OrderingService -> OrderRepository;
  OrderingService -> RemoteKitchenOrderRoutingClient;
  OrderingService -> RabbitMqEventPublisher;

  RemoteKitchenOrderRoutingClient -> KitchenIntegrationController;
  KitchenIntegrationController -> KitchenOrderRoutingService;
  KitchenOrderRoutingService -> KitchenTicketItemWorkflowService;
  KitchenTicketItemWorkflowService -> RemoteInventoryConsumptionClient;
  KitchenTicketItemWorkflowService -> RabbitMqEventPublisher;

  BillsController -> BillingBillCreationService;
  BillsController -> BillingPaymentService;
  BillingPaymentService -> PaymentGateway;
  CashPaymentGateway -> PaymentGateway [arrowhead=empty, style=dashed];
  ExternalReferencePaymentGateway -> PaymentGateway [arrowhead=empty, style=dashed];
  BillingBillCreationService -> RabbitMqEventPublisher;
  BillingPaymentService -> RabbitMqEventPublisher;

  RabbitMqEventPublisher -> ReportingProjectionConsumer;
  RabbitMqEventPublisher -> NotificationRequestedConsumer;
  RabbitMqEventPublisher -> AuditRecordingRequestedConsumer;
}
