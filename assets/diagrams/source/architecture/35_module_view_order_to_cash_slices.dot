digraph G {
  graph [
    rankdir=TB,
    compound=true,
    bgcolor="white",
    pad=0.25,
    nodesep=0.55,
    ranksep=0.75,
    splines=polyline,
    fontname="Arial",
    labelloc="t",
    label="Module View - Order-to-Cash Package Collaboration"
  ];

  node [
    shape=folder,
    style="filled",
    fillcolor="#FFFFFF",
    color="#64748B",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.08,0.05"
  ];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.7, labeldistance=1.2, labelangle=20, decorate=true];

  res_app [label="reservation.application\nReservationCheckInService\nReservationTableAssignmentService"];
  ord_app [label="ordering.application\nOrdersService\nOrderCreationService\nOrderDraftConfirmationService"];
  ord_domain [label="ordering.domain\nOrderStatusPolicy\nComboPricingPolicy"];
  kit_app [label="kitchen.application\nKitchenOrderRoutingService\nKitchenTicketItemWorkflowService"];
  kit_domain [label="kitchen.domain\nKitchenStatusPolicy\nKitchenPriorityPolicy"];
  bill_app [label="billing.application\nBillingBillCreationService\nBillingPaymentService\nBillingReceiptService"];
  bill_domain [label="billing.domain\nBillSplitStrategy\nEqualSplitStrategy\nSeatSplitStrategy"];
  inv_app [label="inventory.application\nInventoryKitchenConsumptionService\nInventoryStockService"];
  common_async [label="common.outbox / common.messaging\nTransactionalOutboxPublisher\nRabbitMqOutboxRelay"];
  support [label="reporting / notification / identity\nprojection, delivery, audit"];

  order_events_note [shape=note, fillcolor="#FEF3C7", label="order events"];
  kitchen_events_note [shape=note, fillcolor="#FEF3C7", label="kitchen events"];
  billing_events_note [shape=note, fillcolor="#FEF3C7", label="billing events"];
  stock_events_note [shape=note, fillcolor="#FEF3C7", label="stock events"];
  consumers_note [shape=note, fillcolor="#E0F2FE", label="async consumers"];

  res_app -> ord_app [label="table session context"];
  ord_app -> ord_domain [label="validates order"];
  ord_app -> kit_app [label="RemoteKitchenOrderRoutingClient -> REST"];
  kit_app -> kit_domain [label="ticket transitions"];
  kit_app -> inv_app [label="RemoteInventoryConsumptionClient -> REST"];
  ord_app -> bill_app [label="bill snapshot via bounded API"];
  bill_app -> bill_domain [label="split/payment policy"];

  ord_app -> order_events_note [style=dashed, arrowhead=none, constraint=false];
  kit_app -> kitchen_events_note [style=dashed, arrowhead=none, constraint=false];
  bill_app -> billing_events_note [style=dashed, arrowhead=none, constraint=false];
  inv_app -> stock_events_note [style=dashed, arrowhead=none, constraint=false];

  order_events_note -> common_async [style=dashed];
  kitchen_events_note -> common_async [style=dashed];
  billing_events_note -> common_async [style=dashed];
  stock_events_note -> common_async [style=dashed];
  common_async -> consumers_note [style=dashed, arrowhead=none];
  consumers_note -> support [style=dashed];
}
