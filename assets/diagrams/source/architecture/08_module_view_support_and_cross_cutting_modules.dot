digraph G {
  graph [
    rankdir=TB,
    compound=true,
    bgcolor="white",
    pad=0.35,
    nodesep=0.55,
    ranksep=0.9,
    splines=ortho,
    fontname="Arial",
    labelloc="t",
    label="Module View - Supporting and cross-cutting packages"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.1, fontname="Arial", fontsize=10];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.7];

  common_outbox [label="common.outbox\nTransactionalOutboxPublisher\nRabbitMqOutboxRelay"];
  common_messaging [label="common.messaging\nRabbitMqEventPublisher\nManualAckConsumerSupport"];
  common_notification [label="common.notification\nNotificationCommandPublisher"];
  common_identity [label="common.identity\nSharedIdentity*Port\nRemoteSharedIdentity*Client"];
  common_workflow [label="common.workflow\nWorkflowExecutionSupport"];

  inventory_workflow [label="inventory.application.workflow\nInventoryStockChangedConsumer\nInventoryAlertMediator"];
  notification_msg [label="notification.infrastructure.messaging\nNotificationRequestedConsumer"];
  notification_app [label="notification.application\nNotificationRequestMaterializer\nNotificationChannelAdapter"];
  reporting_msg [label="reporting.infrastructure.messaging\nReportingProjectionConsumer"];
  reporting_app [label="reporting.application\nReportingQueryService\nReportingProjectionHandler"];
  identity_msg [label="identity.infrastructure.messaging\nAuditRecordingRequestedConsumer\nSessionTouchRequestedConsumer"];
  identity_app [label="identity.application\nAuthService\nAuditService\nSettingsService"];
  identity_persistence [label="identity.persistence\nIdentityRepository\nIdentityPolicyRepository"];

  common_outbox -> common_messaging [label="publishes through"];
  common_messaging -> inventory_workflow [label="manual ack support"];
  common_messaging -> notification_msg [label="manual ack support"];
  common_messaging -> reporting_msg [label="manual ack support"];
  common_messaging -> identity_msg [label="manual ack support"];

  inventory_workflow -> common_outbox [label="low-stock follow-up"];
  notification_msg -> notification_app;
  notification_app -> common_notification;
  reporting_msg -> reporting_app;
  identity_msg -> identity_app;
  identity_app -> identity_persistence;

  reporting_app -> common_identity [label="name / policy lookup"];
  notification_app -> common_identity [label="user context"];
  inventory_workflow -> common_workflow;
  reporting_app -> common_workflow;
  identity_app -> common_workflow;
}
