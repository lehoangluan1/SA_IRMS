digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.52,
    ranksep=0.88,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Component Diagram - Supporting Async and Cross-Cutting Runtime"
  ];

  node [shape=component, style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=8.6, margin="0.10,0.06"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=7.8];

  subgraph cluster_sources {
    label="Event Sources";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReservationService [label="ReservationService\nreservation events"];
    OrderingService [label="OrderingService\norder events"];
    KitchenService [label="KitchenService\nkitchen events"];
    BillingService [label="BillingService\nbilling events"];
    InventoryService [label="InventoryService\nstock events"];
  }

  subgraph cluster_messaging {
    label="Messaging";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    RabbitMqEventPublisher [label="RabbitMqEventPublisher"];
    ManualAckConsumerSupport [label="ManualAckConsumerSupport"];
  }

  subgraph cluster_consumers {
    label="Consumers";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    InventoryStockChangedConsumer [label="InventoryStockChangedConsumer\nRabbit listener"];
    ReportingProjectionConsumer [label="ReportingProjectionConsumer\nRabbit listener"];
    NotificationRequestedConsumer [label="NotificationRequestedConsumer\nRabbit listener"];
    AuditRecordingRequestedConsumer [label="AuditRecordingRequestedConsumer\nRabbit listener"];
  }

  subgraph cluster_adapters {
    label="Adapters and Policies";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    LowStockSeverityPolicy [label="LowStockSeverityPolicy"];
    ReorderRecommendationStrategy [label="ReorderRecommendationStrategy\ninterface"];
    EmailNotificationChannelAdapter [label="EmailNotificationChannelAdapter"];
    SmsNotificationChannelAdapter [label="SmsNotificationChannelAdapter"];
    InAppNotificationChannelAdapter [label="InAppNotificationChannelAdapter"];
    PrintNotificationChannelAdapter [label="PrintNotificationChannelAdapter"];
    AuditReadService [label="AuditReadService"];
  }

  ReservationService -> RabbitMqEventPublisher;
  OrderingService -> RabbitMqEventPublisher;
  KitchenService -> RabbitMqEventPublisher;
  BillingService -> RabbitMqEventPublisher;
  InventoryService -> RabbitMqEventPublisher;

  RabbitMqEventPublisher -> ManualAckConsumerSupport;
  ManualAckConsumerSupport -> InventoryStockChangedConsumer;
  ManualAckConsumerSupport -> ReportingProjectionConsumer;
  ManualAckConsumerSupport -> NotificationRequestedConsumer;
  ManualAckConsumerSupport -> AuditRecordingRequestedConsumer;

  InventoryStockChangedConsumer -> LowStockSeverityPolicy;
  InventoryStockChangedConsumer -> ReorderRecommendationStrategy;
  NotificationRequestedConsumer -> EmailNotificationChannelAdapter;
  NotificationRequestedConsumer -> SmsNotificationChannelAdapter;
  NotificationRequestedConsumer -> InAppNotificationChannelAdapter;
  NotificationRequestedConsumer -> PrintNotificationChannelAdapter;
  AuditRecordingRequestedConsumer -> AuditReadService;
}
