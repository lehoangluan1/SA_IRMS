digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.56,
    ranksep=0.96,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Supporting and Cross-Cutting Modules of IRMS"
  ];

  node [
    shape=folder,
    style="filled",
    fillcolor="#FFFFFF",
    color="#64748B",
    penwidth=1.0,
    fontname="DejaVu Sans",
    fontsize=9.5,
    margin="0.14,0.08"
  ];

  edge [
    style=dashed,
    arrowhead=vee,
    color="#64748B",
    penwidth=0.9,
    fontname="DejaVu Sans",
    fontsize=8.0
  ];

  subgraph cluster_model {
    label="<<model>> Module View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_sources {
      label="<<package>> Operational Source Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      reservation_source [label="Reservation Source\nreservation events,\nwaitlist state,\nseating updates"];
      ordering_source [label="Ordering Source\norder events,\nmodifier updates,\nstate transitions"];
      kitchen_source [label="Kitchen Source\ndish-ready events,\nserve events,\nstation updates"];
      billing_source [label="Billing Source\npayment events,\nrefund trace,\nreceipt state"];
    }

    subgraph cluster_support {
      label="<<package>> Support Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      contracts [label="Shared Event Contracts\nreservation event,\norder fact,\nserve fact,\npayment fact"];
      inventory_support [label="Inventory Package\nstock projection,\nrecipe usage,\nthreshold policy"];
      reporting_support [label="Reporting Package\nread-model projection,\nKPI query,\ntrend analysis"];
      notification_support [label="Notification Package\nreservation message,\nlow-stock alert,\ne-receipt orchestration"];
    }

    subgraph cluster_governance {
      label="<<package>> Cross-Cutting Governance Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      iam_package [label="IAM Package\nrole resolution,\nauthorization policy,\naccess decision"];
      audit_package [label="Audit Package\naudit recorder,\ntrace enrichment,\ncompliance query"];
    }

    subgraph cluster_boundary {
      label="<<package>> Boundary and Adapter Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      payment_adapter [label="Payment Gateway Adapter"];
      receipt_adapter [label="Receipt Printer Adapter"];
      notification_adapter [label="Notification Sender Adapter"];
    }
  }

  reservation_source -> contracts [label="publish"];
  ordering_source -> contracts [label="publish"];
  kitchen_source -> contracts [label="publish"];
  billing_source -> contracts [label="publish"];

  contracts -> inventory_support [label="consume"];
  contracts -> reporting_support [label="consume"];
  contracts -> notification_support [label="consume"];
  contracts -> audit_package [label="consume"];

  iam_package -> reservation_source [label="authorize"];
  iam_package -> ordering_source [label="authorize"];
  iam_package -> kitchen_source [label="authorize"];
  iam_package -> billing_source [label="authorize"];

  billing_source -> payment_adapter [label="capture and refund"];
  billing_source -> receipt_adapter [label="issue receipt"];
  notification_support -> notification_adapter [label="dispatch"];
}
