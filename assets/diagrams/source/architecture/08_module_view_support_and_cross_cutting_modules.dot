digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    bgcolor="white",
    splines=polyline,
    nodesep=0.55,
    ranksep=0.85,
    pad=0.4,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Module View - Supporting and Cross-Cutting Modules of IRMS"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F8FAFC",
    color="#334155",
    fontname="DejaVu Sans",
    fontsize=11,
    penwidth=1.2,
    margin="0.08,0.05"
  ];

  edge [
    fontname="DejaVu Sans",
    fontsize=9,
    color="#475569",
    arrowsize=0.75
  ];

  subgraph cluster_sources {
    label="Operational Source Modules";
    color="#94A3B8";
    style="rounded";
    reservation [label="Reservation\nreservation, seating,\nwaitlist state"];
    ordering [label="Ordering\norder, modifier,\nstate transition"];
    kitchen [label="Kitchen\nstation status,\nserve handoff"];
    billing [label="Billing\npayment, refund,\nreceipt state"];
  }

  subgraph cluster_support {
    label="Supporting Modules";
    color="#9BB5FF";
    style="rounded";
    inventory [label="Inventory Monitoring\nstock movement,\nrecipe usage, threshold", fillcolor="#EEF4FF"];
    reporting [label="Reporting & Analytics\nsales KPI,\nkitchen SLA, refund trend", fillcolor="#EEF4FF"];
    notification [label="Notification Integration\nreservation notice,\nreceipt and operational alert", fillcolor="#EEF4FF"];
    contracts [label="Shared Event Contracts\nreservation event,\norder fact, serve fact,\npayment fact", fillcolor="#EEF4FF"];
  }

  subgraph cluster_governance {
    label="Cross-Cutting Governance Modules";
    color="#9BB5FF";
    style="rounded";
    iam [label="Identity & Access Control\nidentity, role,\nauthorization policy", fillcolor="#EEF4FF"];
    audit [label="Audit & Compliance\ncheck-in trace,\noverride and refund trace", fillcolor="#EEF4FF"];
  }

  subgraph cluster_integration {
    label="Integration Boundary";
    color="#9BB5FF";
    style="rounded";
    payment_adapter [label="Payment Gateway Adapter", fillcolor="#EEF4FF"];
    notification_adapter [label="Notification Sender Adapter", fillcolor="#EEF4FF"];
    receipt_adapter [label="Receipt Printer Adapter", fillcolor="#EEF4FF"];
  }

  { rank=same; reservation; ordering; kitchen; billing; }
  { rank=same; inventory; reporting; notification; iam; audit; }
  { rank=same; payment_adapter; notification_adapter; receipt_adapter; }

  reservation -> contracts [style=dashed];
  ordering -> contracts [style=dashed];
  kitchen -> contracts [style=dashed];
  billing -> contracts [style=dashed];

  contracts -> inventory [style=dashed];
  contracts -> reporting [style=dashed];
  contracts -> notification [style=dashed];
  contracts -> audit [style=dashed];

  iam -> reservation [style=dashed, constraint=false];
  iam -> ordering [style=dashed, constraint=false];
  iam -> kitchen [style=dashed, constraint=false];
  iam -> billing [style=dashed, constraint=false];

  billing -> payment_adapter [label="capture / refund"];
  billing -> receipt_adapter [label="issue receipt"];
  notification -> notification_adapter [label="dispatch"];
}
