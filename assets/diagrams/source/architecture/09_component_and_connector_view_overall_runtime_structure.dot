digraph G {
  rankdir=LR;

  graph [bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.7, splines=ortho, fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans", fontsize=11, color="#334155"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.7];

  node [shape=component, style="filled", fillcolor="#F8FAFC", fontname="DejaVu Sans", fontsize=11, color="#334155"];
  "HostUI" [label="Host UI"];
  "ServerUI" [label="Server UI"];
  "KitchenUI" [label="Kitchen UI"];
  "CashierUI" [label="Cashier UI"];
  "ManagerUI" [label="Manager UI"];
  "AdminUI" [label="Admin UI"];
  "API" [label="API / Controller Layer"];
  "AUTH" [label="Authentication / Authorization Filter"];
  "RAS" [label="ReservationApplicationService"];
  "OAS" [label="OrderingApplicationService"];
  "KAS" [label="KitchenApplicationService"];
  "BAS" [label="BillingApplicationService"];
  "IAS" [label="InventoryApplicationService"];
  "RQS" [label="ReportingQueryService"];
  "AAS" [label="AdminApplicationService"];
  "RD" [label="Reservation Domain"];
  "OD" [label="Ordering Domain"];
  "KD" [label="Kitchen Domain"];
  "BD" [label="Billing Domain"];
  "ID" [label="Inventory Domain"];
  "AD" [label="Audit Domain"];
  "REPO" [label="Repository Layer"];
  "TX" [label="Transaction Manager"];
  "ED" [label="Event Dispatcher"];
  "BJW" [label="Background Job Worker"];
  "PGA" [label="Payment Gateway Adapter"];
  "NA" [label="Notification Adapter"];
  "RPA" [label="Receipt Printer Adapter"];
  "DB" [label="«database»
Relational Database", shape=cylinder, style="filled", fillcolor="#F1F5F9"];

  edge [arrowhead=open];
  "HostUI" -> "API" [label="HTTPS / JSON"];
  "ServerUI" -> "API" [label="HTTPS / JSON"];
  "KitchenUI" -> "API" [label="HTTPS / JSON"];
  "CashierUI" -> "API" [label="HTTPS / JSON"];
  "ManagerUI" -> "API" [label="HTTPS / JSON"];
  "AdminUI" -> "API" [label="HTTPS / JSON"];
  "API" -> "AUTH";
  "API" -> "RAS";
  "API" -> "OAS";
  "API" -> "KAS";
  "API" -> "BAS";
  "API" -> "IAS";
  "API" -> "RQS";
  "API" -> "AAS";
  "RAS" -> "RD";
  "OAS" -> "OD";
  "KAS" -> "KD";
  "BAS" -> "BD";
  "IAS" -> "ID";
  "AAS" -> "AD";
  "RD" -> "REPO";
  "OD" -> "REPO";
  "KD" -> "REPO";
  "BD" -> "REPO";
  "ID" -> "REPO";
  "AD" -> "REPO";
  "REPO" -> "TX";
  "TX" -> "DB";
  edge [style=dashed, arrowhead=open];
  "OAS" -> "ED" [label="publishes OrderConfirmed"];
  "KAS" -> "ED" [label="publishes DishReady"];
  "BAS" -> "ED" [label="publishes PaymentCompleted"];
  "IAS" -> "ED" [label="publishes LowStockDetected"];
  edge [style=solid, arrowhead=open];
  "ED" -> "BJW";
  "BJW" -> "NA" [label="notifications"];
  "BJW" -> "RPA" [label="print jobs"];
  "BAS" -> "PGA" [label="authorize / capture / refund"];
  "RQS" -> "DB" [label="query views"];
}
