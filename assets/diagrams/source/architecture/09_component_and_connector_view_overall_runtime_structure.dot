digraph G {
  graph [
    rankdir=TB,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.25,
    margin=0.05,
    nodesep=0.55,
    ranksep=0.70,
    splines=polyline,
    fontname="Arial",
    labelloc="t",
    label="Component-and-Connector View - Runtime Collaboration Overview"
  ];

  node [
    shape=component,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#475569",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.09,0.05"
  ];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.65];

  ui [shape=rect, label="Restaurant Staff UI\nReact / Nitro frontend"];
  rest_req [shape=plaintext, label="(", fontsize=18, margin=0];
  rest_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  svc_req [shape=plaintext, label="(", fontsize=18, margin=0];
  svc_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  app_req [shape=plaintext, label="(", fontsize=18, margin=0];
  app_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  jdbc_req [shape=plaintext, label="(", fontsize=18, margin=0];
  jdbc_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  event_req [shape=plaintext, label="(", fontsize=18, margin=0];
  event_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  amqp_req [shape=plaintext, label="(", fontsize=18, margin=0];
  amqp_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  delivery_req [shape=plaintext, label="(", fontsize=18, margin=0];
  delivery_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];

  subgraph cluster_gateway {
    label="<<subsystem>> API Gateway";
    color="#93C5FD";
    style="rounded";
    gateway [label="<<component>>\nGatewayProxyController"];
    routes [label="<<component>>\nGatewayRouteLocator"];
  }

  subgraph cluster_backend {
    label="<<subsystem>> Backend service runtimes";
    color="#93C5FD";
    style="rounded";
    controllers [
      label="<<component>>\nREST Controllers\nReservation / Orders / Kitchen\nBilling / Inventory / Reporting / Auth"
    ];
    services [
      label="<<component>>\nApplication Services\nOrdersService / KitchenService\nBillingService / ReportingQueryService"
    ];
  }

  subgraph cluster_event {
    label="<<subsystem>> Event infrastructure";
    color="#CBD5E1";
    style="rounded";
    outbox [label="<<component>>\nTransactionalOutboxPublisher"];
    relay [label="<<component>>\nRabbitMqOutboxRelay"];
    rabbit [shape=box3d, label="<<broker>>\nRabbitMQ"];
    ack [label="<<component>>\nManualAckConsumerSupport"];
    consumers [label="<<component>>\nBackground consumers\nInventory / Reporting\nNotification / Audit"];
  }

  db [
    shape=cylinder,
    label="<<database>>\nPostgreSQL\nsingle physical database\ntransaction tables\noutbox_events / processed_events\nreporting projections"
  ];

  ui -> rest_req [arrowhead=none, label="requires"];
  rest_req -> rest_if [arrowhead=none, label="REST /api/**"];
  rest_if -> gateway [style=dashed, arrowhead=none, label="delegation"];
  gateway -> routes [style=dashed, arrowhead=none, label="route config"];

  gateway -> svc_req [arrowhead=none, label="requires"];
  svc_req -> svc_if [arrowhead=none, label="service REST APIs"];
  svc_if -> controllers [style=dashed, arrowhead=none, label="delegation"];

  controllers -> app_req [arrowhead=none, label="requires"];
  app_req -> app_if [arrowhead=none, label="application calls"];
  app_if -> services [style=dashed, arrowhead=none, label="delegation"];

  services -> jdbc_req [arrowhead=none, label="requires"];
  jdbc_req -> jdbc_if [arrowhead=none, label="JDBC"];
  jdbc_if -> db [arrowhead=none, label="provided"];

  services -> event_req [arrowhead=none, label="requires"];
  event_req -> event_if [arrowhead=none, label="DomainEventPublisher"];
  event_if -> outbox [style=dashed, arrowhead=none, label="delegation"];
  outbox -> db [arrowhead=none, label="append outbox rows"];
  relay -> db [style=dashed, arrowhead=none, label="poll unpublished rows"];
  relay -> amqp_req [arrowhead=none, label="requires"];
  amqp_req -> amqp_if [arrowhead=none, label="AMQP publish"];
  amqp_if -> rabbit [arrowhead=none, label="provided"];
  rabbit -> delivery_if [arrowhead=none, label="AMQP delivery"];
  ack -> delivery_req [arrowhead=none, label="requires"];
  delivery_req -> delivery_if [arrowhead=none];
  ack -> consumers [arrowhead=none, label="consumer execution"];
}
