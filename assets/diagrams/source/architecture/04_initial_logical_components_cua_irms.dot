digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=1.00,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Initial Logical Structure of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.8, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.2];

  subgraph cluster_model {
    label="<<model>> Logical View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_frontline {
      label="<<package>> Frontline Capabilities";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      reservation [label="Reservation\nrequests and records"];
      seating [label="Seating\nwaitlist and assignment"];
      ordering [label="Ordering\norder capture"];
      kitchen [label="Kitchen Dispatch\nticket routing"];
      billing [label="Bill Generation\nbillable lines"];
      payment [label="Payment Processing\ncash, card and wallet"];
    }

    subgraph cluster_support {
      label="<<package>> Reference and Support";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      menu [label="Menu Reference\nitems and availability"];
      inventory [label="Inventory Tracking\nstock and recipe usage"];
      reporting [label="Reporting and Analytics\nsales and service metrics"];
      notification [label="Notification Delivery\nreservation, alert and receipt"];
    }

    subgraph cluster_governance {
      label="<<package>> Governance";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      access [label="Access Control\nroles and permissions"];
      audit [label="Audit and Review\noverride and refund trace"];
    }
  }

  reservation -> seating [label="booking context"];
  seating -> ordering [label="table session"];
  menu -> ordering [label="menu and price snapshot"];
  ordering -> kitchen [label="confirmed items"];
  ordering -> billing [label="billable items"];
  billing -> payment [label="settlement"];

  kitchen -> inventory [label="served item facts"];
  payment -> notification [label="receipt notice"];
  reservation -> notification [label="reservation notice"];
  ordering -> reporting [label="sales facts"];
  payment -> reporting [label="revenue facts"];

  access -> reservation [label="authorize"];
  access -> ordering [label="authorize"];
  access -> payment [label="authorize"];
  ordering -> audit [label="override trace"];
  payment -> audit [label="refund trace"];
  inventory -> audit [label="stock trace"];
}
