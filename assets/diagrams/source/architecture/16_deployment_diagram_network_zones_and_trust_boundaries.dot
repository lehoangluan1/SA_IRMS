digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.42,
    nodesep=0.52,
    ranksep=0.95,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Network Zones and Trust Boundaries"
  ];

  node [fontname="DejaVu Sans", fontsize=11, color="#334155", penwidth=1.1, style="filled"];
  edge [fontname="DejaVu Sans", fontsize=9.8, color="#64748B", penwidth=1.0, arrowsize=0.72];

  subgraph cluster_foh {
    label="Front-of-House Zone";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#FFFBEB";
    host [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nHost Tablet"];
    server [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nServer Tablet"];
    cashier [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nCashier Terminal"];
  }

  subgraph cluster_boh {
    label="Back-of-House Zone";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#FFFBEB";
    kds [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nKitchen Display Client"];
    manager [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nManager Console"];
  }

  subgraph cluster_app {
    label="Application Zone";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    frontend [shape=box3d, fillcolor="#DBEAFE", color="#60A5FA", label="<<node>>\nfrontend container"];
    gateway [shape=box3d, fillcolor="#DBEAFE", color="#60A5FA", label="<<node>>\napi-gateway container"];
    services [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nSpring Boot service containers"];
    frontend -> gateway [label="/api proxy"];
    gateway -> services [label="route REST"];
  }

  subgraph cluster_data {
    label="Data and Messaging Zone";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";
    postgres [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nPostgreSQL container\nsingle physical database"];
    rabbitmq [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nRabbitMQ container"];
    txschema [shape=note, fillcolor="#FFFFFF", label="<<artifact>>\ntransaction tables"];
    readm [shape=note, fillcolor="#FFFFFF", label="<<artifact>>\nreporting projection tables"];
    outbox [shape=note, fillcolor="#FFFFFF", label="<<artifact>>\noutbox_events\nprocessed_events"];
    postgres -> txschema [arrowhead=none];
    postgres -> readm [arrowhead=none];
    postgres -> outbox [arrowhead=none];
  }

  { rank=same; host; server; cashier; }
  { rank=same; kds; manager; }
  { rank=same; frontend; gateway; services; postgres; rabbitmq; }

  host -> frontend [label="HTTP"];
  server -> frontend [label="HTTP"];
  cashier -> frontend [label="HTTP"];
  kds -> frontend [label="HTTP"];
  manager -> frontend [label="HTTP"];

  services -> postgres [label="JDBC"];
  services -> rabbitmq [style=dashed, label="publish / consume"];
}
