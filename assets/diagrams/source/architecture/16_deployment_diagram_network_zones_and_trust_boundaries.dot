digraph G {
  rankdir=TB;

  graph [bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.7, splines=ortho, fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans", fontsize=11, color="#334155"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.7];

  node [shape=box3d, style="filled", fillcolor="#ECFEFF", fontname="DejaVu Sans", fontsize=11, color="#334155"];
  subgraph cluster_foh {
    label="Front-of-House Zone"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "Host_Tablet" [label="«device»
Host Tablet", fillcolor="#FEFCE8"];
    "Server_Tablet" [label="«device»
Server Tablet", fillcolor="#FEFCE8"];
    "Cashier_Terminal" [label="«device»
Cashier Terminal", fillcolor="#FEFCE8"];
  }
  subgraph cluster_boh {
    label="Back-of-House Zone"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "Kitchen_Display_Client" [label="«device»
Kitchen Display Client", fillcolor="#FEFCE8"];
    "Manager_Console" [label="«device»
Manager Console", fillcolor="#FEFCE8"];
  }
  subgraph cluster_app {
    label="Application Zone"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "Reverse_Proxy_Web_Server" [label="«device»
Reverse Proxy / Web Server"];
    "IRMS_Backend" [label="«device»
IRMS Backend Node"];
    "Backend_Runtime" [label="«executionEnvironment»
Application Runtime", fillcolor="#F8FAFC"];
    "Background_Worker" [label="«device»
Background Worker"];
    "IRMS_Backend" -> "Backend_Runtime" [arrowhead=none];
  }
  subgraph cluster_data {
    label="Data Zone"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "DB_Server" [label="«device»
Operational DB Server"];
    "Operational_Database" [label="«executionEnvironment»
Operational Database", fillcolor="#F8FAFC"];
    "Read_Model_Reporting_Views" [label="«artifact»
Reporting Views", shape=note, fillcolor="#F8FAFC"];
    "DB_Server" -> "Operational_Database" [arrowhead=none];
  }
  subgraph cluster_external {
    label="External Integration Zone"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "Payment_Gateway" [label="«device»
Payment Gateway"];
    "Notification_Service" [label="«device»
Notification Service"];
  }
  edge [arrowhead=open];
  "Host_Tablet" -> "Reverse_Proxy_Web_Server" [label="reservation / seating API"];
  "Server_Tablet" -> "Reverse_Proxy_Web_Server" [label="order API"];
  "Cashier_Terminal" -> "Reverse_Proxy_Web_Server" [label="billing API"];
  "Kitchen_Display_Client" -> "IRMS_Backend" [label="kitchen status API"];
  "Manager_Console" -> "IRMS_Backend" [label="reporting / admin API"];
  "Reverse_Proxy_Web_Server" -> "IRMS_Backend" [label="route + auth"];
  "IRMS_Backend" -> "DB_Server" [label="transactional data"];
  "Background_Worker" -> "Read_Model_Reporting_Views" [label="async refresh"];
  "IRMS_Backend" -> "Background_Worker" [label="publish jobs"];
  "IRMS_Backend" -> "Payment_Gateway" [label="payment calls"];
  "Background_Worker" -> "Notification_Service" [label="notifications"];
}
