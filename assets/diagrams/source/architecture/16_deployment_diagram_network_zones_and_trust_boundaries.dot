digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.42,
    nodesep=0.48,
    ranksep=0.9,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Network Zones and Trust Boundaries"
  ];

  node [fontname="DejaVu Sans", fontsize=11, color="#334155", penwidth=1.1, style="filled"];
  edge [fontname="DejaVu Sans", fontsize=9.8, color="#64748B", penwidth=1.0, arrowsize=0.72];

  subgraph cluster_foh {
    label="Front-of-House Zone";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#FFFBEB";
    host [shape=box3d, fillcolor="#FEFCE8", label="«device»
Host Tablet"];
    server [shape=box3d, fillcolor="#FEFCE8", label="«device»
Server Tablet"];
    cashier [shape=box3d, fillcolor="#FEFCE8", label="«device»
Cashier Terminal"];
  }

  subgraph cluster_boh {
    label="Back-of-House Zone";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#FFFBEB";
    kds [shape=box3d, fillcolor="#FEFCE8", label="«device»
Kitchen Display Client"];
    manager [shape=box3d, fillcolor="#FEFCE8", label="«device»
Manager Console"];
  }

  subgraph cluster_app {
    label="Application Zone";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    proxy [shape=box3d, fillcolor="#DBEAFE", color="#60A5FA", label="«device»
Reverse Proxy / Web Server"];
    backend [shape=box3d, fillcolor="#ECFEFF", label="«device»
IRMS Backend Node"];
    runtime [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»
Application Runtime"];
    worker [shape=box3d, fillcolor="#ECFEFF", label="«device»
Background Worker"];
    backend -> runtime [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_data {
    label="Data Zone";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";
    db [shape=box3d, fillcolor="#ECFEFF", label="«device»
Operational DB Server"];
    dbms [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»
PostgreSQL"];
    readm [shape=note, fillcolor="#FFFFFF", label="«artifact»
Reporting Views / Read Model"];
    db -> dbms [arrowhead=none, color="#94A3B8"];
    dbms -> readm [arrowhead=none, color="#94A3B8"];
  }

  printer [shape=box3d, fillcolor="#ECFEFF", label="«device»
Receipt Printer Gateway"];

  subgraph cluster_external {
    label="External Integration Zone";
    color="#CBD5E1";
    style="rounded,dashed";
    payment [shape=box3d, fillcolor="#F8FAFC", label="«external»
Payment Gateway"];
    notify [shape=box3d, fillcolor="#F8FAFC", label="«external»
Notification Service"];
  }

  { rank=same; host; server; cashier; }
  { rank=same; kds; manager; }
  { rank=same; proxy; backend; worker; db; payment; notify; }

  host    -> proxy   [label="HTTPS"];
  server  -> proxy   [label="HTTPS"];
  cashier -> proxy   [label="HTTPS"];
  kds     -> proxy   [label="HTTPS"];
  manager -> proxy   [label="HTTPS"];

  proxy   -> backend [label="route + auth"];
  backend -> db      [label="transactional data"];
  backend -> worker  [style=dashed, label="publish jobs"];
  worker  -> readm   [label="async refresh"];
  backend -> payment [label="payment calls"];
  worker  -> notify  [label="notifications"];
  worker  -> printer [label="print jobs"];

  proxy -> backend [weight=8];
  backend -> worker [style=invis, weight=8];
  worker -> db [style=invis, weight=8];
  db -> payment [style=invis, weight=8];
}
