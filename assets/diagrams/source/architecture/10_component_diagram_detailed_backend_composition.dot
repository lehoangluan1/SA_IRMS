digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.25,
    margin=0.05,
    nodesep=0.55,
    ranksep=0.85,
    splines=polyline,
    fontname="Arial",
    labelloc="t",
    label="Component Diagram - Service Ports and Persistence Adapters"
  ];

  node [
    shape=component,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#475569",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.09,0.05"
  ];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.65];

  clients [shape=rect, label="Staff UI / API Gateway"];
  rest_req [shape=plaintext, label="(", fontsize=18, margin=0];
  rest_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];
  app_req [shape=plaintext, label="(", fontsize=18, margin=0];
  app_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];
  repo_req [shape=plaintext, label="(", fontsize=18, margin=0];
  repo_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];
  adapter_req [shape=plaintext, label="(", fontsize=18, margin=0];
  adapter_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];
  event_req [shape=plaintext, label="(", fontsize=18, margin=0];
  event_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];
  jdbc_req [shape=plaintext, label="(", fontsize=18, margin=0];
  jdbc_if [shape=circle, label="", fixedsize=true, width=0.20, height=0.20, style="filled", fillcolor="white"];

  subgraph cluster_api {
    label="<<subsystem>> API layer";
    color="#93C5FD";
    style="rounded";
    controllers [
      label="<<component>>\nREST Controllers\nOrders / Kitchen / Billing\nReservation / Inventory\nReporting / Identity"
    ];
  }

  subgraph cluster_application {
    label="<<subsystem>> Application services";
    color="#93C5FD";
    style="rounded";
    app_services [
      label="<<component>>\nApplication Services\nOrdersService / KitchenService\nBillingService / ReservationService\nInventoryService / ReportingQueryService\nAuthService / AuditService"
    ];
  }

  subgraph cluster_adapters {
    label="<<subsystem>> Provided adapters";
    color="#CBD5E1";
    style="rounded";
    jdbc_adapters [
      label="<<component>>\nJDBC adapters\nJdbcOrderRepository\nJdbcKitchen*Adapter\nJdbcBilling*Repository\nJdbcReservation*Adapter\nJdbcInventory*Repository"
    ];
    boundary_adapters [
      label="<<component>>\nBoundary adapters\nCashPaymentGateway\nExternalReferencePaymentGateway\nReceiptDeliveryAdapter\nRemoteSharedIdentity*Client"
    ];
    outbox_adapter [label="<<component>>\nTransactionalOutboxPublisher"];
  }

  db [shape=cylinder, label="<<database>>\nPostgreSQL\nsingle physical database"];

  clients -> rest_req [arrowhead=none];
  rest_req -> rest_if [arrowhead=none, label="REST API"];
  rest_if -> controllers [style=dashed, arrowhead=none, label="delegation"];

  controllers -> app_req [arrowhead=none];
  app_req -> app_if [arrowhead=none, label="application service"];
  app_if -> app_services [style=dashed, arrowhead=none, label="delegation"];

  app_services -> repo_req [arrowhead=none, headlabel="required", labeldistance=1.2, labelangle=20];
  repo_req -> repo_if [arrowhead=none, label="RepositoryPort"];
  repo_if -> jdbc_adapters [style=dashed, arrowhead=none, label="provided"];

  app_services -> adapter_req [arrowhead=none, headlabel="required", labeldistance=1.2, labelangle=-20];
  adapter_req -> adapter_if [arrowhead=none, label="Payment / Receipt / Identity"];
  adapter_if -> boundary_adapters [style=dashed, arrowhead=none, label="provided"];

  app_services -> event_req [arrowhead=none];
  event_req -> event_if [arrowhead=none, label="DomainEventPublisher"];
  event_if -> outbox_adapter [style=dashed, arrowhead=none, label="provided"];

  jdbc_adapters -> jdbc_req [arrowhead=none];
  outbox_adapter -> jdbc_req [arrowhead=none, headlabel="outbox_events", labeldistance=1.2, labelangle=20];
  jdbc_req -> jdbc_if [arrowhead=none, label="JDBC"];
  jdbc_if -> db [arrowhead=none];
}
