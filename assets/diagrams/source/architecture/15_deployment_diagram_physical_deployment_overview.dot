digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.42,
    nodesep=0.52,
    ranksep=0.95,
    splines=line,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Physical Deployment Overview"
  ];

  node [fontname="DejaVu Sans", fontsize=11, color="#334155", penwidth=1.1, style="filled"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#64748B", penwidth=1.0, arrowsize=0.72];

  subgraph cluster_clients {
    label="Restaurant Endpoints";
    color="#CBD5E1";
    style="rounded";
    host [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nHost Tablet"];
    server [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nServer Tablet"];
    kitchen [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nKitchen Display Station"];
    cashier [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nCashier Terminal"];
    manager [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nManager Console"];
  }

  subgraph cluster_edge {
    label="Application Edge";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    frontend [shape=box3d, fillcolor="#DBEAFE", color="#60A5FA", label="<<node>>\nfrontend container\nReact UI and Nitro Proxy"];
    gateway [shape=box3d, fillcolor="#DBEAFE", color="#60A5FA", label="<<node>>\napi-gateway container"];
  }

  subgraph cluster_core {
    label="Spring Boot Service Containers";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#F8FAFC";
    ordering [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nordering-service"];
    kitchen_service [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nkitchen-service"];
    billing [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nbilling-service"];
    reservation [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nreservation-service"];
    inventory [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\ninventory-service"];
    support [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nnotification, reporting,\nidentity-audit"];
    migration [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nirms-migration"];
  }

  subgraph cluster_data {
    label="Data and Messaging Tier";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";
    postgres [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nPostgreSQL container\npostgres-data volume"];
    rabbitmq [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nRabbitMQ container\nrabbitmq-data volume"];
    outbox [shape=note, fillcolor="#FFF7ED", color="#FDBA74", label="<<artifact>>\noutbox_events and processed_events"];
    readm [shape=note, fillcolor="#FFF7ED", color="#FDBA74", label="<<artifact>>\nReporting tables and views"];
  }

  { rank=same; host; server; kitchen; cashier; manager; }
  { rank=same; frontend; gateway; }
  { rank=same; ordering; kitchen_service; billing; reservation; inventory; support; migration; }
  { rank=same; postgres; rabbitmq; outbox; readm; }

  host -> frontend [label="HTTP"];
  server -> frontend [label="HTTP"];
  kitchen -> frontend [label="HTTP"];
  cashier -> frontend [label="HTTP"];
  manager -> frontend [label="HTTP"];

  frontend -> gateway [label="/api proxy"];
  gateway -> ordering [label="REST"];
  gateway -> kitchen_service [label="REST"];
  gateway -> billing [label="REST"];
  gateway -> reservation [label="REST"];
  gateway -> inventory [label="REST"];
  gateway -> support [label="REST"];

  ordering -> postgres [label="JDBC"];
  kitchen_service -> postgres [label="JDBC"];
  billing -> postgres [label="JDBC"];
  reservation -> postgres [label="JDBC"];
  inventory -> postgres [label="JDBC"];
  support -> postgres [label="JDBC"];
  migration -> postgres [label="Flyway"];
  ordering -> rabbitmq [style=dashed, label="events"];
  kitchen_service -> rabbitmq [style=dashed, label="events"];
  billing -> rabbitmq [style=dashed, label="events"];
  inventory -> rabbitmq [style=dashed, label="events"];
  postgres -> outbox [arrowhead=none];
  postgres -> readm [arrowhead=none];
}
