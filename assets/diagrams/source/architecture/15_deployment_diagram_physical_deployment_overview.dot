digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.42,
    nodesep=0.52,
    ranksep=0.95,
    splines=line,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Physical Deployment Overview"
  ];

  node [
    fontname="DejaVu Sans",
    fontsize=11,
    color="#334155",
    penwidth=1.1,
    style="filled"
  ];

  edge [
    fontname="DejaVu Sans",
    fontsize=10,
    color="#64748B",
    penwidth=1.0,
    arrowsize=0.72
  ];

  subgraph cluster_clients {
    label="Restaurant Endpoints";
    color="#CBD5E1";
    style="rounded";

    host [
      shape=box3d,
      fillcolor="#FEFCE8",
      label="«device»\nHost Tablet"
    ];

    server [
      shape=box3d,
      fillcolor="#FEFCE8",
      label="«device»\nServer Tablet"
    ];

    kitchen [
      shape=box3d,
      fillcolor="#FEFCE8",
      label="«device»\nKitchen Display Station"
    ];

    cashier [
      shape=box3d,
      fillcolor="#FEFCE8",
      label="«device»\nCashier Terminal"
    ];

    manager [
      shape=box3d,
      fillcolor="#FEFCE8",
      label="«device»\nManager Console"
    ];
  }

  subgraph cluster_edge {
    label="Application Edge";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";

    proxy [
      shape=box3d,
      fillcolor="#DBEAFE",
      color="#60A5FA",
      label="«device»\nReverse Proxy / Web Server"
    ];
  }

  subgraph cluster_core {
    label="Central Application Tier";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#F8FAFC";

    apphost [
      shape=box3d,
      fillcolor="#ECFEFF",
      label="«device»\nIRMS Application Node"
    ];

    apprt [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«executionEnvironment»\nApplication Runtime"
    ];

    workerh [
      shape=box3d,
      fillcolor="#ECFEFF",
      label="«device»\nBackground Worker Node"
    ];

    workrt [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«executionEnvironment»\nWorker Runtime"
    ];

    printer [
      shape=box3d,
      fillcolor="#ECFEFF",
      label="«device»\nReceipt Printer Gateway"
    ];

    apphost -> apprt [arrowhead=none, color="#94A3B8"];
    workerh -> workrt [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_data {
    label="Data Tier";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";

    dbhost [
      shape=box3d,
      fillcolor="#ECFEFF",
      label="«device»\nOperational Database Node"
    ];

    pg [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«executionEnvironment»\nPostgreSQL"
    ];

    opdb [
      shape=note,
      fillcolor="#FFF7ED",
      color="#FDBA74",
      label="«artifact»\nOperational Schema"
    ];

    readm [
      shape=note,
      fillcolor="#FFF7ED",
      color="#FDBA74",
      label="«artifact»\nReporting Views / Read Model"
    ];

    objstore [
      shape=note,
      fillcolor="#FFF7ED",
      color="#FDBA74",
      label="«artifact»\nObject Storage\n(Receipts / Menu Assets)"
    ];

    dbhost -> pg [arrowhead=none, color="#94A3B8"];
    pg -> opdb [arrowhead=none, color="#94A3B8"];
    pg -> readm [arrowhead=none, color="#94A3B8"];
    pg -> objstore [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_external {
    label="External Services";
    color="#CBD5E1";
    style="rounded,dashed";

    payment [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«external»\nPayment Gateway Service"
    ];

    notify [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«external»\nNotification Service"
    ];
  }

  { rank=same; host; server; kitchen; cashier; manager; }
  { rank=same; proxy; apphost; workerh; dbhost; payment; notify; }

  host    -> proxy [label="HTTPS"];
  server  -> proxy [label="HTTPS"];
  kitchen -> proxy [label="HTTPS"];
  cashier -> proxy [label="HTTPS"];
  manager -> proxy [label="HTTPS"];

  proxy   -> apphost [label="route + auth"];
  apphost -> dbhost  [label="transactional data"];
  apphost -> workerh [label="async jobs / event handoff", style=dashed];
  workerh -> dbhost  [label="job state / refresh reporting views", style=dashed];
  apphost -> payment [label="payment calls"];
  workerh -> notify  [label="notifications"];
  workerh -> printer [label="print jobs"];

  proxy  -> apphost [weight=8];
  apphost -> workerh [weight=6];
  workerh -> dbhost [weight=6];
}