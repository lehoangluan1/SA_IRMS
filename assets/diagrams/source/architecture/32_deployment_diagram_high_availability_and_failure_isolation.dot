digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.42,
    nodesep=0.52,
    ranksep=0.95,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Local Docker Runtime and Failure Isolation"
  ];

  node [
    fontname="DejaVu Sans",
    fontsize=10.8,
    color="#334155",
    penwidth=1.1,
    style="filled"
  ];

  edge [
    fontname="DejaVu Sans",
    fontsize=9.4,
    color="#64748B",
    penwidth=1.0,
    arrowsize=0.72
  ];

  subgraph cluster_clients {
    label="Restaurant Endpoints";
    color="#CBD5E1";
    style="rounded";

    host [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nHost Tablet"];
    server [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nServer Tablet"];
    kitchen [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nKitchen Display"];
    cashier [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nCashier Terminal"];
    manager [shape=box3d, fillcolor="#FEFCE8", label="<<device>>\nManager Console"];
  }

  frontend [
    shape=box3d,
    fillcolor="#DBEAFE",
    color="#60A5FA",
    label="<<node>>\nfrontend container\nReact UI and Nitro Proxy"
  ];

  subgraph cluster_app {
    label="Spring Boot Containers";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";

    gateway [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\napi-gateway"];
    services [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\ndomain services\nordering, kitchen, billing,\nreservation, inventory,\nnotification, reporting,\nidentity-audit"];
    migration [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nirms-migration"];
  }

  subgraph cluster_state {
    label="Stateful Tier";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";

    queue [shape=component, fillcolor="#FEF3C7", color="#F59E0B", label="<<artifact>>\noutbox_events and processed_events"];
    dbPrimary [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nPostgreSQL container"];
    broker [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nRabbitMQ container"];
    views [shape=note, fillcolor="#FFFFFF", label="<<artifact>>\nReporting tables and views"];
  }

  legend [shape=plaintext, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#F8FAFC"><B>Legend</B></TD></TR>
      <TR><TD ALIGN="LEFT">solid = synchronous request path</TD></TR>
      <TR><TD ALIGN="LEFT">dashed = async event path or startup dependency</TD></TR>
    </TABLE>
  >];

  { rank=same; host; server; kitchen; cashier; manager; }
  { rank=same; gateway; services; migration; }
  { rank=same; dbPrimary; broker; }

  host    -> frontend [label="HTTP"];
  server  -> frontend [label="HTTP"];
  kitchen -> frontend [label="HTTP"];
  cashier -> frontend [label="HTTP"];
  manager -> frontend [label="HTTP"];

  frontend -> gateway [label="/api proxy"];
  gateway -> services [label="REST routing"];

  services -> dbPrimary [label="transactional read/write"];
  migration -> dbPrimary [label="Flyway migrations"];
  migration -> services [style=dashed, label="start after migration"];

  services -> queue [style=dashed, label="write / claim events"];
  services -> broker [style=dashed, label="publish / consume events"];
  services -> views [label="refresh projections"];
  dbPrimary -> views [style=dashed, label="read source"];
  broker -> views [style=dashed, label="projection events"];

  views -> legend [style=invis];
}
