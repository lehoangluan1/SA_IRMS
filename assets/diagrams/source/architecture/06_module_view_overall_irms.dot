digraph G {
  graph [
    rankdir=LR,
    compound=true,
    bgcolor="white",
    pad=0.35,
    nodesep=0.55,
    ranksep=0.9,
    splines=ortho,
    fontname="Arial",
    labelloc="t",
    label="Module View - Backend Package Responsibility Boundaries"
  ];

  node [
    shape=folder,
    style="filled",
    fillcolor="#FFFFFF",
    color="#64748B",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.12,0.07"
  ];
  edge [
    color="#64748B",
    fontname="Arial",
    fontsize=9,
    arrowsize=0.7
  ];

  gateway [label="SA.irms.gateway\nAPI gateway package"];
  common [label="SA.irms.common\nshared platform package"];

  subgraph cluster_domain_packages {
    label="Business service packages";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";

    reservation [label="SA.irms.reservation\napi / application / infrastructure"];
    ordering [label="SA.irms.ordering\napi / application / domain / infrastructure"];
    kitchen [label="SA.irms.kitchen\napi / application / domain / infrastructure"];
    billing [label="SA.irms.billing\napi / application / domain / infrastructure"];
    inventory [label="SA.irms.inventory\napi / application / domain / infrastructure"];
    notification [label="SA.irms.notification\napi / application / infrastructure"];
    reporting [label="SA.irms.reporting\napi / application / infrastructure"];
    identity [label="SA.irms.identity\napi / application / persistence / audit"];
  }

  subgraph cluster_runtime {
    label="Runtime entrypoint packages";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#F8FAFC";

    runtime [label="SA.irms.runtime\nservice SpringBootApplication classes"];
    adapters [label="SA.irms.adapters.pdf\nReceiptPdfRenderer"];
  }

  gateway -> common [headlabel="uses", labeldistance=1.4, labelangle=20];
  gateway -> reservation;
  gateway -> ordering;
  gateway -> kitchen;
  gateway -> billing;
  gateway -> inventory;
  gateway -> notification;
  gateway -> reporting;
  gateway -> identity;

  reservation -> common;
  ordering -> common;
  kitchen -> common;
  billing -> common;
  inventory -> common;
  notification -> common;
  reporting -> common;
  identity -> common;

  billing -> adapters [headlabel="receipt PDF", labeldistance=1.4, labelangle=20];
  runtime -> gateway [headlabel="api-gateway", labeldistance=1.4, labelangle=20];
  runtime -> reservation;
  runtime -> ordering;
  runtime -> kitchen;
  runtime -> billing;
  runtime -> inventory;
  runtime -> notification;
  runtime -> reporting;
  runtime -> identity;
}
