digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=1.02,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Overall Module Structure of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.8, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.2];

  subgraph cluster_model {
    label="<<model>> Module View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_core {
      label="<<package>> Core Transaction Modules";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      reservation [label="Table and Reservation"];
      menu [label="Menu"];
      ordering [label="Ordering"];
      kitchen [label="Kitchen Coordination"];
      billing [label="Billing and Payment"];
    }

    subgraph cluster_support {
      label="<<package>> Support Modules";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      inventory [label="Inventory"];
      reporting [label="Reporting"];
      notification [label="Notification"];
    }

    subgraph cluster_governance {
      label="<<package>> Governance Modules";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      iam [label="Identity and Access Control"];
      audit [label="Audit Log"];
    }
  }

  reservation -> ordering [label="table and session context"];
  menu -> ordering [label="item validation and pricing"];
  ordering -> kitchen [label="confirmed order items"];
  ordering -> billing [label="order snapshot"];
  billing -> reservation [label="release session"];

  inventory -> ordering [label="recipe and availability context"];
  kitchen -> inventory [label="served item event"];

  ordering -> reporting [label="sales facts"];
  billing -> reporting [label="settlement facts"];
  inventory -> reporting [label="stock facts"];

  reservation -> notification [label="reservation event"];
  billing -> notification [label="receipt event"];
  inventory -> notification [label="low-stock alert"];

  iam -> ordering [label="authorize"];
  iam -> billing [label="authorize"];
  iam -> reporting [label="authorize"];

  ordering -> audit [label="override trace"];
  billing -> audit [label="refund trace"];
  iam -> audit [label="policy trace"];
}
