digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.52,
    ranksep=0.92,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Component Diagram - IRMS Runtime Dependency Overview"
  ];

  node [shape=component, style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=8.8, margin="0.10,0.06"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=7.8];

  subgraph cluster_frontend {
    label="Frontend";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ApiClient [label="apiFetch"];
    Endpoints [label="ENDPOINTS"];
    PermissionRules [label="permissions.ts"];
  }

  subgraph cluster_gateway {
    label="Gateway";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    GatewayProxyController [label="GatewayProxyController"];
    GatewayRouteLocator [label="GatewayRouteLocator"];
  }

  subgraph cluster_core {
    label="Core Application Services";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReservationService [label="ReservationService"];
    OrderingService [label="OrderingService"];
    KitchenService [label="KitchenService"];
    BillingService [label="BillingService"];
    InventoryService [label="InventoryService"];
  }

  subgraph cluster_support {
    label="Supporting Services";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReportingQueryService [label="ReportingQueryService"];
    NotificationService [label="NotificationService"];
    AuthService [label="AuthService"];
    AuditReadService [label="AuditReadService"];
  }

  subgraph cluster_async {
    label="Shared Event Infrastructure";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    RabbitMqEventPublisher [label="RabbitMqEventPublisher"];
    OutboxRelayScheduler [label="OutboxRelayScheduler"];
  }

  ApiClient -> Endpoints;
  ApiClient -> GatewayProxyController;
  PermissionRules -> ApiClient;
  GatewayProxyController -> GatewayRouteLocator;

  GatewayProxyController -> ReservationService;
  GatewayProxyController -> OrderingService;
  GatewayProxyController -> KitchenService;
  GatewayProxyController -> BillingService;
  GatewayProxyController -> InventoryService;
  GatewayProxyController -> ReportingQueryService;
  GatewayProxyController -> NotificationService;
  GatewayProxyController -> AuthService;
  GatewayProxyController -> AuditReadService;

  ReservationService -> RabbitMqEventPublisher;
  OrderingService -> RabbitMqEventPublisher;
  KitchenService -> RabbitMqEventPublisher;
  BillingService -> RabbitMqEventPublisher;
  InventoryService -> RabbitMqEventPublisher;
  OutboxRelayScheduler -> RabbitMqEventPublisher;
}
