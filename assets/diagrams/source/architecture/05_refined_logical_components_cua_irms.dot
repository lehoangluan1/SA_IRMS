digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.56,
    ranksep=1.05,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Refined Logical Capability Model of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.8, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.2];

  subgraph cluster_model {
    label="<<model>> Logical View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_core {
      label="<<package>> Core Transaction Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      table_reservation [label="Table and Reservation"];
      ordering [label="Ordering"];
      kitchen [label="Kitchen Coordination"];
      billing [label="Billing and Settlement"];
    }

    subgraph cluster_reference {
      label="<<package>> Reference Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      menu [label="Menu Management"];
      inventory [label="Inventory Monitoring"];
    }

    subgraph cluster_governance {
      label="<<package>> Governance Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      iam [label="Identity and Access Control"];
      audit [label="Audit and Compliance"];
    }

    subgraph cluster_support {
      label="<<package>> Support Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      notification [label="Notification Integration"];
      reporting [label="Reporting and Analytics"];
    }
  }

  table_reservation -> ordering [label="table context"];
  menu -> ordering [label="availability and price snapshot"];
  ordering -> kitchen [label="confirmed items"];
  ordering -> billing [label="billable order snapshot"];
  kitchen -> inventory [label="served item event"];
  billing -> table_reservation [label="close table session"];

  table_reservation -> notification [label="reservation update"];
  billing -> notification [label="receipt event"];
  inventory -> notification [label="low-stock alert"];

  ordering -> reporting [label="sales facts"];
  billing -> reporting [label="settlement facts"];
  inventory -> reporting [label="stock facts"];

  iam -> ordering [label="authorize"];
  iam -> billing [label="authorize"];
  ordering -> audit [label="override trace"];
  billing -> audit [label="refund trace"];
}
