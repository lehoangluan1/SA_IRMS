digraph G {
  graph [
    rankdir=TB,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.28,
    margin=0.05,
    nodesep=0.48,
    ranksep=0.70,
    splines=polyline,
    fontname="Arial",
    labelloc="t",
    label="Component Diagram - Asynchronous Processing and Read Models"
  ];

  node [
    shape=component,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#475569",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.09,0.05"
  ];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.65];

  services [label="<<component>>\nApplication services\nOrders / Kitchen / Billing / Inventory"];
  outbox [label="<<component>>\nTransactionalOutboxPublisher"];
  relay [label="<<component>>\nRabbitMqOutboxRelay"];
  publisher [label="<<component>>\nRabbitMqEventPublisher"];
  rabbit [shape=box3d, label="<<broker>>\nRabbitMQ"];
  ack [label="<<component>>\nManualAckConsumerSupport"];

  outbox_req [shape=plaintext, label="(", fontsize=18, margin=0];
  outbox_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  amqp_req [shape=plaintext, label="(", fontsize=18, margin=0];
  amqp_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  delivery_req [shape=plaintext, label="(", fontsize=18, margin=0];
  delivery_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  exec_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  jdbc_req [shape=plaintext, label="(", fontsize=18, margin=0];
  jdbc_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  outbox_rows_note [shape=note, fillcolor="#FEF3C7", label="OutboxRows\nfrom PostgreSQL"];

  subgraph cluster_consumers {
    label="<<subsystem>> Background consumers";
    color="#93C5FD";
    style="rounded";
    inventory_consumer [label="<<component>>\nInventoryStockChangedConsumer"];
    reporting_consumer [label="<<component>>\nReportingProjectionConsumer"];
    notification_consumer [label="<<component>>\nNotificationRequestedConsumer"];
    audit_consumer [label="<<component>>\nAuditRecordingRequestedConsumer"];
    session_consumer [label="<<component>>\nSessionTouchRequestedConsumer"];
  }

  subgraph cluster_materializers {
    label="<<subsystem>> Materializers, services and adapters";
    color="#CBD5E1";
    style="rounded";
    inventory_repo [label="<<component>>\nInventoryAlertMediator\nJdbcInventoryRepositories"];
    reporting_repo [label="<<component>>\nReportingQueryService\nJdbcProjectionMaterializers"];
    notification_repo [label="<<component>>\nNotificationRequestMaterializer\nJdbcNotificationService\nNotificationChannelAdapter"];
    audit_repo [label="<<component>>\nAuditEventMaterializer\nIdentityAuditWriteRepository"];
    identity_repo [label="<<component>>\nIdentityRepository"];
  }

  db [
    shape=cylinder,
    label="<<database>>\nPostgreSQL\nsingle physical database\noutbox_events / processed_events\nreporting projections\naudit, notification, inventory tables"
  ];

  services -> outbox_req [arrowhead=none, label="required"];
  outbox_req -> outbox_if [arrowhead=none, label="OutboxPort"];
  outbox_if -> outbox [arrowhead=none, label="provided"];

  outbox -> db [arrowhead=none, label="JDBC append events"];
  { rank=same; relay; outbox_rows_note; }
  relay -> outbox_rows_note [style=dashed, arrowhead=none, constraint=false];
  outbox_rows_note -> db [style=dashed, arrowhead=none, constraint=false];

  relay -> publisher [arrowhead=none, label="delegation"];
  publisher -> amqp_req [arrowhead=none];
  amqp_req -> amqp_if [arrowhead=none, label="AMQP publish"];
  amqp_if -> rabbit [arrowhead=none];

  rabbit -> delivery_if [arrowhead=none, label="AMQP delivery"];
  ack -> delivery_req [arrowhead=none];
  delivery_req -> delivery_if [arrowhead=none];
  ack -> exec_if [arrowhead=none, label="consumer execution"];

  exec_if -> inventory_consumer [style=dashed, arrowhead=none, label="delegation"];
  exec_if -> reporting_consumer [style=dashed, arrowhead=none];
  exec_if -> notification_consumer [style=dashed, arrowhead=none];
  exec_if -> audit_consumer [style=dashed, arrowhead=none];
  exec_if -> session_consumer [style=dashed, arrowhead=none];

  inventory_consumer -> inventory_repo [arrowhead=none];
  reporting_consumer -> reporting_repo [arrowhead=none];
  notification_consumer -> notification_repo [arrowhead=none];
  audit_consumer -> audit_repo [arrowhead=none];
  session_consumer -> identity_repo [arrowhead=none];

  inventory_repo -> jdbc_req [arrowhead=none];
  reporting_repo -> jdbc_req [arrowhead=none];
  notification_repo -> jdbc_req [arrowhead=none];
  audit_repo -> jdbc_req [arrowhead=none];
  identity_repo -> jdbc_req [arrowhead=none];
  jdbc_req -> jdbc_if [arrowhead=none, label="JDBC"];
  jdbc_if -> db [arrowhead=none];
}
