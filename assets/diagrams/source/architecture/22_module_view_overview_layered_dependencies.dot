digraph G {
  graph [
    rankdir=TB,
    compound=true,
    bgcolor="white",
    pad=0.35,
    nodesep=0.55,
    ranksep=0.9,
    splines=ortho,
    fontname="Arial",
    labelloc="t",
    label="Module View - Layered Dependencies in Backend Services"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.1, fontname="Arial", fontsize=10];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.7];

  api [label="*.api\nSpring REST controllers"];
  application [label="*.application\nuse-case services, workflows, views"];
  domain [label="*.domain\npolicies, strategies, records"];
  ports [label="*.application.port.out\nrepository and integration interfaces"];
  infrastructure [label="*.infrastructure\nJDBC adapters, messaging adapters"];
  integration [label="*.integration\nbounded REST clients"];
  common [label="SA.irms.common\nsecurity, outbox, messaging, workflow, errors"];
  runtime [label="SA.irms.runtime / gateway\nSpring Boot entrypoints and routing"];

  runtime -> api;
  runtime -> common [style=dashed];
  api -> application;
  api -> common [style=dashed];
  application -> domain;
  application -> ports;
  application -> common [style=dashed];
  ports -> infrastructure [style=dashed, arrowhead=open];
  application -> integration;
  integration -> common [style=dashed];
  infrastructure -> common [style=dashed];
}
