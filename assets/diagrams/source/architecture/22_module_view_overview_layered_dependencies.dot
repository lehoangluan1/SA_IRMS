digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.54,
    ranksep=0.88,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Component Diagram - Layered Runtime Entry and Service Dependencies"
  ];

  node [shape=component, style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.2, margin="0.10,0.06"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.0];

  subgraph cluster_gateway {
    label="Gateway";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ApiGatewayApplication [label="ApiGatewayApplication"];
    GatewayProxyController [label="GatewayProxyController"];
    GatewayRouteLocator [label="GatewayRouteLocator"];
  }

  subgraph cluster_api {
    label="API Controllers";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReservationController [label="ReservationController\n/api/reservations"];
    OrdersController [label="OrdersController\n/api/orders"];
    KitchenController [label="KitchenController\n/api/kitchen"];
    BillsController [label="BillsController\n/api/bills"];
    InventoryController [label="InventoryController\n/api/inventory"];
    ReportingController [label="ReportingController\n/api/reports"];
    AuthController [label="AuthController\n/api/auth"];
    AuditController [label="AuditController\n/api/audit"];
  }

  subgraph cluster_application {
    label="Application Services";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    ReservationService [label="ReservationService"];
    OrderingService [label="OrderingService"];
    KitchenService [label="KitchenService"];
    BillingService [label="BillingService"];
    InventoryService [label="InventoryService"];
    ReportingQueryService [label="ReportingQueryService"];
    AuthService [label="AuthService"];
    AuditReadService [label="AuditReadService"];
  }

  subgraph cluster_platform {
    label="Shared Platform Components";
    color="#BFDBFE";
    style="rounded,filled";
    fillcolor="#F8FBFF";
    RabbitMqEventPublisher [label="RabbitMqEventPublisher"];
    OutboxRelayScheduler [label="OutboxRelayScheduler"];
    ManualAckConsumerSupport [label="ManualAckConsumerSupport"];
    RestClientConfiguration [label="RestClientConfiguration"];
  }

  ApiGatewayApplication -> GatewayProxyController;
  GatewayProxyController -> GatewayRouteLocator;
  GatewayProxyController -> RestClientConfiguration;

  ReservationController -> ReservationService;
  OrdersController -> OrderingService;
  KitchenController -> KitchenService;
  BillsController -> BillingService;
  InventoryController -> InventoryService;
  ReportingController -> ReportingQueryService;
  AuthController -> AuthService;
  AuditController -> AuditReadService;

  ReservationService -> RabbitMqEventPublisher;
  OrderingService -> RabbitMqEventPublisher;
  KitchenService -> RabbitMqEventPublisher;
  BillingService -> RabbitMqEventPublisher;
  InventoryService -> RabbitMqEventPublisher;
  OutboxRelayScheduler -> RabbitMqEventPublisher;
  ManualAckConsumerSupport -> RabbitMqEventPublisher;
}
