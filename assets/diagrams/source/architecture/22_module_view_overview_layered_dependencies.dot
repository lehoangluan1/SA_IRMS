digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=0.96,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Layered Service Dependencies of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.6, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9];

  subgraph cluster_model {
    label="<<model>> Service Decomposition View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_presentation {
      label="<<package>> Presentation Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      frontline_ui [label="Frontline Interfaces"];
      management_ui [label="Management Interfaces"];
      gateway [label="API Entry and Policy Gate"];
    }

    subgraph cluster_business {
      label="<<package>> Business Service Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      reservation [label="Reservation & Seating\nService"];
      menu [label="Menu Reference"];
      ordering [label="Ordering & Menu\nService"];
      kitchen [label="Kitchen Coordination\nService"];
      billing [label="Billing & Settlement\nService"];
      inventory [label="Inventory Monitoring\nService"];
      reporting [label="Reporting\nService"];
      notification [label="Notification\nService"];
      governance [label="IAM & Audit\nService"];
    }

    subgraph cluster_platform {
      label="<<package>> Shared Platform Capabilities";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      repositories [label="Repository Contracts"];
      events [label="Event Bus and Outbox"];
      readmodel [label="Read Model"];
      adapters [label="External Adapters"];
    }
  }

  frontline_ui -> gateway;
  management_ui -> gateway;

  gateway -> reservation;
  gateway -> ordering;
  gateway -> kitchen;
  gateway -> billing;
  gateway -> reporting;
  gateway -> governance;

  reservation -> ordering;
  menu -> ordering;
  ordering -> kitchen [label="OrderConfirmed"];
  ordering -> billing [label="billable snapshot API"];
  kitchen -> inventory [label="OrderItemPrepared"];
  billing -> notification [label="BillIssued"];
  inventory -> notification [label="InventoryLow"];

  reservation -> repositories;
  ordering -> repositories;
  billing -> repositories;
  inventory -> repositories;
  governance -> repositories;

  reservation -> events;
  ordering -> events;
  billing -> events;
  inventory -> events;

  reporting -> readmodel;
  notification -> adapters;
  billing -> adapters;
}
