digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=0.96,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Layered Module Dependencies of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.6, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9];

  subgraph cluster_model {
    label="<<model>> Module View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_presentation {
      label="<<package>> Presentation Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      frontline_ui [label="Frontline Interfaces"];
      management_ui [label="Management Interfaces"];
      gateway [label="API and Policy Gate"];
    }

    subgraph cluster_business {
      label="<<package>> Business Module Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      reservation [label="Reservation Module"];
      menu [label="Menu Module"];
      ordering [label="Ordering Module"];
      kitchen [label="Kitchen Module"];
      billing [label="Billing Module"];
      inventory [label="Inventory Module"];
      reporting [label="Reporting Module"];
      notification [label="Notification Module"];
      governance [label="IAM and Audit"];
    }

    subgraph cluster_platform {
      label="<<package>> Shared Platform Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      repositories [label="Repository Contracts"];
      events [label="Event Contracts and Outbox"];
      readmodel [label="Read Model"];
      adapters [label="External Adapters"];
    }
  }

  frontline_ui -> gateway;
  management_ui -> gateway;

  gateway -> reservation;
  gateway -> ordering;
  gateway -> kitchen;
  gateway -> billing;
  gateway -> reporting;
  gateway -> governance;

  reservation -> ordering;
  menu -> ordering;
  ordering -> kitchen;
  ordering -> billing;
  kitchen -> inventory;
  billing -> notification;
  inventory -> notification;

  reservation -> repositories;
  ordering -> repositories;
  billing -> repositories;
  inventory -> repositories;
  governance -> repositories;

  reservation -> events;
  ordering -> events;
  billing -> events;
  inventory -> events;

  reporting -> readmodel;
  notification -> adapters;
  billing -> adapters;
}
