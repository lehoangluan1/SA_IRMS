digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.45,
    nodesep=0.6,
    ranksep=1.05,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Data and Execution Mapping"
  ];

  node [fontname="DejaVu Sans", fontsize=10.5, color="#334155", penwidth=1.1, style="filled"];
  edge [fontname="DejaVu Sans", fontsize=9.4, color="#64748B", penwidth=1.0, arrowsize=0.72];

  subgraph cluster_services {
    label="Spring Boot Service Containers";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    ordering [shape=note, label="<<artifact>>\nordering-service"];
    billing [shape=note, label="<<artifact>>\nbilling-service"];
    kitchen [shape=note, label="<<artifact>>\nkitchen-service"];
    inventory [shape=note, label="<<artifact>>\ninventory-service"];
    reporting [shape=note, label="<<artifact>>\nreporting-service"];
    notification [shape=note, label="<<artifact>>\nnotification-service"];
    iam [shape=note, label="<<artifact>>\nidentity-audit-service"];
  }

  subgraph cluster_db {
    label="PostgreSQL Container";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";
    pg [shape=box3d, fillcolor="#F8FAFC", label="<<node>>\nPostgreSQL"];
    txdata [shape=note, label="<<artifact>>\nTransactional Data"];
    readm [shape=note, label="<<artifact>>\nReporting tables and views"];
    outbox [shape=component, fillcolor="#FFF7ED", label="<<artifact>>\noutbox_events\nprocessed_events"];
    pg -> txdata;
    pg -> readm;
    pg -> outbox;
  }

  subgraph cluster_broker {
    label="RabbitMQ Container";
    color="#C4B5FD";
    style="rounded,filled";
    fillcolor="#F5F3FF";
    broker [shape=box3d, fillcolor="#ECFEFF", label="<<node>>\nRabbitMQ"];
    queues [shape=component, fillcolor="#FFFFFF", label="<<artifact>>\nservice event queues"];
    broker -> queues;
  }

  ordering -> txdata [label="orders"];
  billing -> txdata [label="bills and payments"];
  kitchen -> txdata [label="tickets and status"];
  inventory -> txdata [label="stock"];
  iam -> txdata [label="auth and audit"];
  reporting -> readm [label="read queries"];

  ordering -> outbox [style=dashed, label="write events"];
  billing -> outbox [style=dashed];
  kitchen -> outbox [style=dashed];
  inventory -> outbox [style=dashed];
  outbox -> broker [style=dashed, label="relay"];

  queues -> reporting [style=dashed, label="projection events"];
  queues -> notification [style=dashed, label="notification events"];
  queues -> iam [style=dashed, label="audit events"];
  reporting -> readm [style=dashed, label="update projections"];
}
