digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.45,
    nodesep=0.6,
    ranksep=1.05,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Data and Execution Mapping"
  ];

  node [
    fontname="DejaVu Sans",
    fontsize=10.5,
    color="#334155",
    penwidth=1.1,
    style="filled"
  ];

  edge [
    fontname="DejaVu Sans",
    fontsize=9.4,
    color="#64748B",
    penwidth=1.0,
    arrowsize=0.72
  ];

  subgraph cluster_appserver {
    label="Business Service Node";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";

    apphost [
      shape=box3d,
      fillcolor="#ECFEFF",
      label="«device»\nIRMS Application Node"
    ];

    apprt [
      shape=box3d,
      fillcolor="#F8FAFC",
      label="«executionEnvironment»\nService Runtime"
    ];

    ordering  [shape=note, label="«artifact»\nOrdering Service"];
    billing   [shape=note, label="«artifact»\nBilling Service"];
    kitchen   [shape=note, label="«artifact»\nKitchen Service"];
    inventory [shape=note, label="«artifact»\nInventory Service"];
    reporting [shape=note, label="«artifact»\nReporting Service"];
    iam       [shape=note, label="«artifact»\nIAM Service"];

    apphost -> apprt [arrowhead=none];
    apprt -> ordering;
    apprt -> billing;
    apprt -> kitchen;
    apprt -> inventory;
    apprt -> reporting;
    apprt -> iam;
  }

  subgraph cluster_worker {
    label="Event-Driven Worker Node";
    color="#C4B5FD";
    style="rounded,filled";
    fillcolor="#F5F3FF";

    workerh [shape=box3d, fillcolor="#ECFEFF", label="«device»\nBackground Worker Node"];
    workrt  [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»\nWorker Runtime"];

    notifyj [shape=note, label="«artifact»\nNotification Handler"];
    receiptj[shape=note, label="«artifact»\nReceipt Handler"];
    projj   [shape=note, label="«artifact»\nProjection Handler"];

    workerh -> workrt [arrowhead=none];
    workrt -> notifyj;
    workrt -> receiptj;
    workrt -> projj;
  }

  subgraph cluster_db {
    label="Operational Data Node";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";

    dbhost [shape=box3d, fillcolor="#ECFEFF", label="«device»\nDatabase Node"];
    pg     [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»\nPostgreSQL"];

    txdata [shape=note, label="«artifact»\nTransactional Data"];
    readm  [shape=note, label="«artifact»\nRead Model / Reporting Views"];

    outbox [shape=component, fillcolor="#FFF7ED", label="«queue»\nOutbox / Job Queue"];

    dbhost -> pg;
    pg -> txdata;
    pg -> readm;
    pg -> outbox;
  }

  subgraph cluster_external {
    label="External Systems";
    color="#CBD5E1";
    style="rounded,dashed";

    payment [shape=box3d, label="«external»\nPayment Gateway"];
    notify  [shape=box3d, label="«external»\nNotification Service"];
    printer [shape=box3d, label="«external»\nReceipt Printer"];
  }

  // ===== SYNCHRONOUS PATH =====
  ordering -> txdata [label="orders"];
  billing  -> txdata [label="payments"];
  kitchen  -> txdata [label="status"];
  inventory-> txdata [label="stock"];
  iam      -> txdata [label="auth / audit"];
  reporting-> readm  [label="read queries"];

  // ===== EVENT / ASYNC PATH =====
  ordering -> outbox [style=dashed, label="publish event"];
  billing  -> outbox [style=dashed];
  kitchen  -> outbox [style=dashed];

  outbox -> workrt [style=dashed, label="consume"];

  projj -> readm [style=dashed, label="update projections"];
  workrt -> notify [style=dashed, label="notifications"];
  workrt -> printer [style=dashed, label="print jobs"];

  // ===== EXTERNAL =====
  billing -> payment [label="payment API"];

  // layout
  apphost -> workerh [style=invis, weight=8];
  workerh -> dbhost  [style=invis, weight=8];
}