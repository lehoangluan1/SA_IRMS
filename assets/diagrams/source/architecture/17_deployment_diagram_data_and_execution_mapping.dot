digraph G {
  rankdir=LR;

  graph [bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.85, splines=polyline, fontname="Arial"];
  node [fontname="Arial", fontsize=11, color="#334155"];
  edge [fontname="Arial", fontsize=10, color="#475569", arrowsize=0.7];

  node [fontname="DejaVu Sans", fontsize=11, color="#334155"];
  subgraph cluster_appserver {
    label="Application Server"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "APP" [label="«device»
Backend IRMS Application Server", shape=box3d, style="filled", fillcolor="#ECFEFF"];
    "App_Runtime" [label="«executionEnvironment»
IRMS Runtime", shape=box3d, style="filled", fillcolor="#F8FAFC"];
    "TableReservation_Module" [label="«artifact»
table-reservation-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Menu_Module" [label="«artifact»
menu-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Ordering_Module" [label="«artifact»
ordering-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Kitchen_Module" [label="«artifact»
kitchen-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "BillingPayment_Module" [label="«artifact»
billing-payment-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Inventory_Module" [label="«artifact»
inventory-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Reporting_Module" [label="«artifact»
reporting-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "IdentityAccess_Module" [label="«artifact»
identity-access-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Audit_Module" [label="«artifact»
audit-module.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "APP" -> "App_Runtime" [arrowhead=none];
    "App_Runtime" -> "TableReservation_Module" [arrowhead=none];
    "App_Runtime" -> "Menu_Module" [arrowhead=none];
    "App_Runtime" -> "Ordering_Module" [arrowhead=none];
    "App_Runtime" -> "Kitchen_Module" [arrowhead=none];
    "App_Runtime" -> "BillingPayment_Module" [arrowhead=none];
    "App_Runtime" -> "Inventory_Module" [arrowhead=none];
    "App_Runtime" -> "Reporting_Module" [arrowhead=none];
    "App_Runtime" -> "IdentityAccess_Module" [arrowhead=none];
    "App_Runtime" -> "Audit_Module" [arrowhead=none];
  }
  subgraph cluster_worker {
    label="Background Worker"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "WORKER" [label="«device»
Background Worker Host", shape=box3d, style="filled", fillcolor="#ECFEFF"];
    "Worker_Runtime" [label="«executionEnvironment»
Worker Runtime", shape=box3d, style="filled", fillcolor="#F8FAFC"];
    "Notification_Job_Handler" [label="«artifact»
notification-job-handler.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Receipt_Job_Handler" [label="«artifact»
receipt-job-handler.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Projection_Refresh_Handler" [label="«artifact»
projection-refresh-handler.jar", shape=note, style="filled", fillcolor="#FEFCE8"];
    "WORKER" -> "Worker_Runtime" [arrowhead=none];
    "Worker_Runtime" -> "Notification_Job_Handler" [arrowhead=none];
    "Worker_Runtime" -> "Receipt_Job_Handler" [arrowhead=none];
    "Worker_Runtime" -> "Projection_Refresh_Handler" [arrowhead=none];
  }
  subgraph cluster_db {
    label="Operational RDBMS"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    "ODB" [label="«device»
Database Server", shape=box3d, style="filled", fillcolor="#ECFEFF"];
    "PGSQL" [label="«executionEnvironment»
PostgreSQL", shape=box3d, style="filled", fillcolor="#F8FAFC"];
    "Orders_Bills_Payments" [label="«artifact»
orders_bills_payments schema", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Tables_Reservations_Sessions" [label="«artifact»
tables_reservations_sessions schema", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Menu_Promotion_Price_Rules" [label="«artifact»
menu_promotion_price_rules schema", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Inventory_StockTransactions_Recipes" [label="«artifact»
inventory_stocktransactions_recipes schema", shape=note, style="filled", fillcolor="#FEFCE8"];
    "Users_Roles_Permissions_AuditLogs" [label="«artifact»
users_roles_permissions_auditlogs schema", shape=note, style="filled", fillcolor="#FEFCE8"];
    "ODB" -> "PGSQL" [arrowhead=none];
    "PGSQL" -> "Orders_Bills_Payments" [arrowhead=none];
    "PGSQL" -> "Tables_Reservations_Sessions" [arrowhead=none];
    "PGSQL" -> "Menu_Promotion_Price_Rules" [arrowhead=none];
    "PGSQL" -> "Inventory_StockTransactions_Recipes" [arrowhead=none];
    "PGSQL" -> "Users_Roles_Permissions_AuditLogs" [arrowhead=none];
  }
  "RV" [label="«artifact»
Reporting Views", shape=note, style="filled", fillcolor="#F8FAFC"];
  "KDS" [label="«device»
Kitchen Display Client", shape=box3d, style="filled", fillcolor="#ECFEFF"];
  "RP" [label="«device»
Receipt Printer Gateway", shape=box3d, style="filled", fillcolor="#ECFEFF"];
  "PG" [label="«device»
Payment Gateway", shape=box3d, style="filled", fillcolor="#ECFEFF"];
  "NS" [label="«device»
Notification Service", shape=box3d, style="filled", fillcolor="#ECFEFF"];
  edge [arrowhead=open];
  "APP" -> "ODB" [label="shared transactional store"];
  "APP" -> "WORKER" [label="async jobs"];
  "WORKER" -> "RV" [label="refresh read models"];
  "APP" -> "KDS" [label="ticket stream / poll API"];
  "APP" -> "PG" [label="payment adapter"];
  "WORKER" -> "NS" [label="notification adapter"];
  "WORKER" -> "RP" [label="print adapter"];
}
