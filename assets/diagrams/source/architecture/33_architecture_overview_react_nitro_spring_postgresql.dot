digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    bgcolor="#FFFFFF",
    pad=0.5,
    nodesep=0.8,
    ranksep=1.2,
    splines=polyline,
    fontname="Arial",
    dpi=300
  ];

  node [
    fontname="Arial",
    fontsize=12,
    color="#2C3E50",
    shape=box,
    style="rounded,filled",
    penwidth=2,
    margin="0.4,0.3"
  ];

  edge [
    fontname="Arial",
    fontsize=9,
    color="#7F8C8D",
    arrowsize=1.0,
    penwidth=1.5
  ];

  // === CLIENT TIER ===
  users [label="Operational Users\n\nHost | Server | Kitchen\nCashier | Manager",
         fillcolor="#ECF0F1", color="#34495E", fontsize=11, shape=box];

  // === PRESENTATION TIER ===
  frontend [label="ReactJS UI",
           fillcolor="#FFFFFF", color="#61DAFB", fontcolor="#282C34", fontsize=11,
           image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/react-official.png", imagescale=width, width=0.03, height=0.03, labelloc=b, penwidth=2.5];

  // === FRONTEND PROXY AND API GATEWAY ===
  frontend_proxy [label="Frontend Node Server\nNitro API Proxy",
          fillcolor="#F0F9F7", color="#009639", fontcolor="#1a1a1a", fontsize=11, penwidth=2.5];

  gateway [label="Spring Boot API Gateway\nApiGatewayApplication",
          fillcolor="#F0F9F7", color="#009639", fontcolor="#1a1a1a", fontsize=11, penwidth=2.5];

  // === BACKEND RUNTIME ===
  subgraph cluster_runtime {
    label="Spring Boot Service Runtime";
    labelloc=t;
    fontsize=13;
    fontcolor="#FFFFFF";
    color="#6cb33f";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#f6f6f6";
    margin="20,20";

    appLayer [label="Application",
              fillcolor="#F5FBF0", color="#6cb33f", fontcolor="#1a1a1a", fontsize=10,
              image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/spring-logo.png", imagescale=width, width=0.4, height=0.4, labelloc=b, penwidth=2.5];

    subgraph cluster_modules {
      label="Business Services";
      labelloc=t;
      fontsize=11;
      fontcolor="#16A085";
      color="#16A085";
      penwidth=1.5;
      style="rounded,filled";
      fillcolor="#D5F4E6";
      margin="15,15";

      ordering [label="Ordering & Menu\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      reservation [label="Reservation &\nSeating Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      kitchen [label="Kitchen Coordination\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      billing [label="Billing &\nSettlement Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      inventory [label="Inventory Monitoring\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      governance [label="IAM &\nAudit Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      reporting [label="Reporting\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
    }

    rabbitmq [label="RabbitMQ Broker\n\nDomain Event Queues",
           fillcolor="#FF9800", color="#FFFFFF", fontcolor="#FFFFFF", fontsize=10];

    worker [label="Outbox Relay and Consumers\n\nTransactional Outbox\nInbox Deduplication",
           fillcolor="#FF9800", color="#FFFFFF", fontcolor="#FFFFFF", fontsize=10];
  }

  // === DATA TIER ===
  subgraph cluster_data {
    label="Persistent Data Layer";
    labelloc=t;
    fontsize=12;
    fontcolor="#336791";
    color="#336791";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#f0f0f0";
    margin="15,15";

    postgres [label="PostgreSQL\nsingle physical database\n\nLogical table groups:\n- operational transaction tables\n- outbox_events\n- processed_events\n- reporting projection tables\n- identity/session/policy tables\n- audit_logs and audit_details",
              shape=cylinder, fillcolor="#F0F5FB", color="#336791", fontcolor="#1a1a1a",
              width=3.0, height=1.65, penwidth=2.5];
  }

  // === EXTERNAL SERVICES ===
  subgraph cluster_external {
    label="Boundary Adapters";
    labelloc=t;
    fontsize=12;
    fontcolor="#5B4B8A";
    color="#5B4B8A";
    penwidth=1.5;
    style="rounded,dashed";
    fillcolor="#EBDEF0";
    margin="15,15";

    payment [label="PaymentGateway Interface\n\nCashPaymentGateway\nExternalReferencePaymentGateway", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
    notification [label="NotificationChannelAdapter\n\nEmail | SMS | In-App | Print", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
    receipt_adapter [label="ReceiptDeliveryAdapter\n\nPrintReceiptDeliveryAdapter\nDigitalReceiptDeliveryAdapter", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
  }

  // === RANKING ===
  { rank=same; ordering; reservation; kitchen; }
  { rank=same; billing; inventory; governance; }
  { rank=same; postgres; }
  { rank=same; payment; notification; receipt_adapter; }

  // === DATA FLOW - CLIENT TIER ===
  users -> frontend [label="HTTPS", color="#34495E", penwidth=2];
  frontend -> frontend_proxy [label="HTTP", color="#34495E", penwidth=2];
  frontend_proxy -> gateway [label="/api proxy", color="#34495E", penwidth=2];
  gateway -> appLayer [label="REST routing", color="#34495E", penwidth=2];

  // === API TO MODULES ===
  appLayer -> ordering [color="#16A085"];
  appLayer -> reservation [color="#16A085"];
  appLayer -> kitchen [color="#16A085"];
  appLayer -> billing [color="#16A085"];
  appLayer -> inventory [color="#16A085"];
  appLayer -> governance [color="#16A085"];
  appLayer -> reporting [color="#16A085"];

  // === MODULES TO DATABASE ===
  ordering -> postgres [color="#336791"];
  reservation -> postgres [color="#336791"];
  kitchen -> postgres [color="#336791"];
  billing -> postgres [color="#336791"];
  inventory -> postgres [color="#336791"];
  governance -> postgres [color="#336791"];

  // === INTER-MODULE COMMUNICATION ===
  ordering -> kitchen [label="OrderConfirmed", style="solid", color="#27AE60"];
  ordering -> billing [label="billable snapshot API", style="solid", color="#27AE60"];

  // === EVENT STREAMS (ASYNC) ===
  reservation -> rabbitmq [label="ReservationCreated /\nReservationSeated", style="dashed", color="#E67E22"];
  ordering -> rabbitmq [label="OrderConfirmed", style="dashed", color="#E67E22"];
  kitchen -> rabbitmq [label="KitchenTicketCreated /\nKitchenDishStatusChanged", style="dashed", color="#E67E22"];
  billing -> rabbitmq [label="BillIssued /\nPaymentCompleted", style="dashed", color="#E67E22"];
  inventory -> rabbitmq [label="LowStockDetected", style="dashed", color="#E67E22"];
  rabbitmq -> worker [label="deliver events", style="dashed", color="#E67E22"];

  // === WORKER OUTPUTS ===
  worker -> postgres [label="relay, deduplicate\nand refresh projections", color="#336791"];
  billing -> payment [label="capture / refund API", style="solid", color="#8E44AD"];
  worker -> notification [label="send notifications", style="dashed", color="#8E44AD"];
  worker -> receipt_adapter [label="deliver receipt", style="dashed", color="#8E44AD"];

  // === REPORTING ===
  reporting -> postgres [label="query read model", color="#336791"];
}
