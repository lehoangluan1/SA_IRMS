digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.56,
    ranksep=1.02,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Core Service Fulfillment Path of IRMS"
  ];

  node [
    shape=folder,
    style="filled",
    fillcolor="#FFFFFF",
    color="#64748B",
    penwidth=1.0,
    fontname="DejaVu Sans",
    fontsize=9.7,
    margin="0.14,0.08"
  ];

  edge [
    style=dashed,
    arrowhead=vee,
    color="#64748B",
    penwidth=0.9,
    fontname="DejaVu Sans",
    fontsize=8.1
  ];

  subgraph cluster_model {
    label="<<model>> Service Decomposition View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_context {
      label="<<package>> Service Contexts";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      reservation_context [label="Reservation & Seating\nservice context,\nreservation state,\nseating rules"];
      menu_reference [label="Ordering & Menu\ncatalog,\nmodifier rules,\npricing policy"];
    }

    subgraph cluster_execution {
      label="<<package>> Core Service Flow";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";

      ordering_package [label="Ordering & Menu Service\ncommands,\norder aggregate,\nprice snapshot"];
      kitchen_package [label="Kitchen Coordination Service\nticket routing,\nstation queue,\npreparation state"];
      billing_package [label="Billing & Settlement Service\nbill issue,\nsettlement,\nreceipt closure"];
    }
  }

  reservation_context -> ordering_package [label="table-session context"];
  menu_reference -> ordering_package [label="item, modifier and price basis"];
  ordering_package -> kitchen_package [label="OrderConfirmed"];
  ordering_package -> billing_package [label="billable snapshot API"];
  kitchen_package -> billing_package [label="OrderItemPrepared"];
  billing_package -> reservation_context [label="close table session"];
}
