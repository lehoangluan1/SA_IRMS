digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    bgcolor="#FFFFFF",
    pad=0.5,
    nodesep=0.8,
    ranksep=1.2,
    splines=polyline,
    fontname="Arial",
    dpi=300
  ];

  node [
    fontname="Arial",
    fontsize=12,
    color="#2C3E50",
    shape=box,
    style="rounded,filled",
    penwidth=2,
    margin="0.4,0.3"
  ];

  edge [
    fontname="Arial",
    fontsize=9,
    color="#7F8C8D",
    arrowsize=1.0,
    penwidth=1.5
  ];

  // === CLIENT TIER ===
  users [label="Operational Users\n\nHost | Server | Kitchen\nCashier | Manager",
         fillcolor="#ECF0F1", color="#34495E", fontsize=11, shape=box];

  // === PRESENTATION TIER ===
  frontend [label="ReactJS UI",
           fillcolor="#FFFFFF", color="#61DAFB", fontcolor="#282C34", fontsize=11,
           image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/react-official.png", imagescale=width, width=0.03, height=0.03, labelloc=b, penwidth=2.5];

  // === API GATEWAY ===
  gateway [label="Nginx Gateway",
          fillcolor="#F0F9F7", color="#009639", fontcolor="#1a1a1a", fontsize=11,
          image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/nginx-logo-official.png", imagescale=width, width=0.4, height=0.4, labelloc=b, penwidth=2.5];

  // === BACKEND RUNTIME ===
  subgraph cluster_runtime {
    label="Spring Boot Service Runtime";
    labelloc=t;
    fontsize=13;
    fontcolor="#FFFFFF";
    color="#6cb33f";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#f6f6f6";
    margin="20,20";

    appLayer [label="Application",
              fillcolor="#F5FBF0", color="#6cb33f", fontcolor="#1a1a1a", fontsize=10,
              image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/spring-logo.png", imagescale=width, width=0.4, height=0.4, labelloc=b, penwidth=2.5];

    subgraph cluster_modules {
      label="Business Services";
      labelloc=t;
      fontsize=11;
      fontcolor="#16A085";
      color="#16A085";
      penwidth=1.5;
      style="rounded,filled";
      fillcolor="#D5F4E6";
      margin="15,15";

      ordering [label="Ordering & Menu\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      reservation [label="Reservation &\nSeating Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      kitchen [label="Kitchen Coordination\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      billing [label="Billing &\nSettlement Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      inventory [label="Inventory Monitoring\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      governance [label="IAM &\nAudit Service", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
      reporting [label="Reporting\nService", fillcolor="#1ABC9C", color="#FFFFFF", fontcolor="#FFFFFF"];
    }

    worker [label="Background Worker\n\nOutbox Pattern\nEvent Relay | Async Tasks",
           fillcolor="#FF9800", color="#FFFFFF", fontcolor="#FFFFFF", fontsize=10];
  }

  // === DATA TIER ===
  subgraph cluster_data {
    label="Persistent Data Layer - PostgreSQL";
    labelloc=t;
    fontsize=12;
    fontcolor="#336791";
    color="#336791";
    penwidth=2;
    style="rounded,filled";
    fillcolor="#f0f0f0";
    margin="15,15";

    operationalDb [label="Database",
                   shape=cylinder, fillcolor="#F0F5FB", color="#336791", fontcolor="#1a1a1a",
                   image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/postgresql-elephant.png", imagescale=width, width=0.4, height=0.4, labelloc=b, penwidth=2.5];
    reportingDb [label="Reporting Read Model",
                 shape=cylinder, fillcolor="#F0F5FB", color="#336791", fontcolor="#1a1a1a",
                 image="C:/Users/LUAN/Downloads/SA_BTL/assets/logos/postgresql-elephant.png", imagescale=width, width=0.4, height=0.4, labelloc=b, penwidth=2.5];
  }

  // === EXTERNAL SERVICES ===
  subgraph cluster_external {
    label="Boundary Adapters and Providers";
    labelloc=t;
    fontsize=12;
    fontcolor="#5B4B8A";
    color="#5B4B8A";
    penwidth=1.5;
    style="rounded,dashed";
    fillcolor="#EBDEF0";
    margin="15,15";

    payment [label="Payment Gateway\n\nAuthorize | Capture\nRefund Processing", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
    notification [label="Notification Service\n\nEmail | SMS\nPush Channels", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
    printer [label="Receipt Printer Adapter\n\nKitchen Display\nPOS Terminal Output", fillcolor="#9B59B6", color="#FFFFFF", fontcolor="#FFFFFF"];
  }

  // === RANKING ===
  { rank=same; ordering; reservation; kitchen; }
  { rank=same; billing; inventory; governance; }
  { rank=same; operationalDb; reportingDb; }
  { rank=same; payment; notification; printer; }

  // === DATA FLOW - CLIENT TIER ===
  users -> frontend [label="HTTPS", color="#34495E", penwidth=2];
  frontend -> gateway [label="HTTPS/JSON", color="#34495E", penwidth=2];
  gateway -> appLayer [color="#34495E", penwidth=2];

  // === API TO MODULES ===
  appLayer -> ordering [color="#16A085"];
  appLayer -> reservation [color="#16A085"];
  appLayer -> kitchen [color="#16A085"];
  appLayer -> billing [color="#16A085"];
  appLayer -> inventory [color="#16A085"];
  appLayer -> governance [color="#16A085"];
  appLayer -> reporting [color="#16A085"];

  // === MODULES TO DATABASE ===
  ordering -> operationalDb [color="#336791"];
  reservation -> operationalDb [color="#336791"];
  kitchen -> operationalDb [color="#336791"];
  billing -> operationalDb [color="#336791"];
  inventory -> operationalDb [color="#336791"];
  governance -> operationalDb [color="#336791"];

  // === INTER-MODULE COMMUNICATION ===
  ordering -> kitchen [label="OrderConfirmed", style="solid", color="#27AE60"];
  ordering -> billing [label="billable snapshot API", style="solid", color="#27AE60"];

  // === EVENT STREAMS (ASYNC) ===
  reservation -> worker [label="ReservationConfirmed /\nTableSessionOpened", style="dashed", color="#E67E22"];
  ordering -> worker [label="OrderConfirmed", style="dashed", color="#E67E22"];
  kitchen -> worker [label="OrderItemPrepared", style="dashed", color="#E67E22"];
  billing -> worker [label="BillIssued /\nPaymentCaptured", style="dashed", color="#E67E22"];
  inventory -> worker [label="InventoryLow", style="dashed", color="#E67E22"];

  // === WORKER OUTPUTS ===
  worker -> reportingDb [label="refresh projections", color="#336791"];
  billing -> payment [label="capture / refund API", style="solid", color="#8E44AD"];
  worker -> notification [label="send notifications", style="dashed", color="#8E44AD"];
  worker -> printer [label="print receipt", style="dashed", color="#8E44AD"];

  // === REPORTING ===
  reporting -> reportingDb [label="query", color="#336791"];
}
