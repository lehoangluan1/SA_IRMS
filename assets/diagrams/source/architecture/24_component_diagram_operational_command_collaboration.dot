digraph G {
  graph [
    rankdir=TB,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.25,
    margin=0.05,
    nodesep=0.55,
    ranksep=0.70,
    splines=polyline,
    fontname="Arial",
    labelloc="t",
    label="Component Diagram - Operational Command Path"
  ];

  node [
    shape=component,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#475569",
    penwidth=1.1,
    fontname="Arial",
    fontsize=10,
    margin="0.09,0.05"
  ];
  edge [color="#64748B", fontname="Arial", fontsize=9, arrowsize=0.65];

  ui [shape=rect, label="Staff UI"];
  rest_req [shape=plaintext, label="(", fontsize=18, margin=0];
  gateway_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  orders_req [shape=plaintext, label="(", fontsize=18, margin=0];
  orders_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  app_req [shape=plaintext, label="(", fontsize=18, margin=0];
  app_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  auth_req [shape=plaintext, label="(", fontsize=18, margin=0];
  auth_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  jdbc_req [shape=plaintext, label="(", fontsize=18, margin=0];
  jdbc_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  event_req [shape=plaintext, label="(", fontsize=18, margin=0];
  event_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  kitchen_req [shape=plaintext, label="(", fontsize=18, margin=0];
  kitchen_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];
  amqp_req [shape=plaintext, label="(", fontsize=18, margin=0];
  amqp_if [shape=circle, label="", fixedsize=true, width=0.18, height=0.18, style="filled", fillcolor="white"];

  subgraph cluster_gateway {
    label="<<subsystem>> API Gateway";
    color="#93C5FD";
    style="rounded";
    gateway [label="<<component>>\nGatewayProxyController"];
  }

  subgraph cluster_ordering {
    label="<<subsystem>> Ordering service";
    color="#93C5FD";
    style="rounded";
    controller [label="<<component>>\nOrdersController"];
    service [label="<<component>>\nOrdersService"];
    confirm [label="<<component>>\nOrderDraftConfirmationService"];
  }

  guard [label="<<component>>\nPermissionGuard\nCurrentUser"];
  kitchen_controller [label="<<component>>\nKitchenIntegrationController"];
  kitchen_service [label="<<component>>\nKitchenOrderRoutingService"];
  outbox [label="<<component>>\nTransactionalOutboxPublisher"];
  relay [label="<<component>>\nRabbitMqOutboxRelay"];
  rabbit [shape=box3d, label="<<broker>>\nRabbitMQ"];

  db [shape=cylinder, label="<<database>>\nPostgreSQL\nsingle physical database"];

  ui -> rest_req [arrowhead=none, label="requires"];
  rest_req -> gateway_if [arrowhead=none, label="REST /api/orders"];
  gateway_if -> gateway [style=dashed, arrowhead=none, label="delegation"];

  gateway -> orders_req [arrowhead=none, label="requires"];
  orders_req -> orders_if [arrowhead=none, label="/api/orders"];
  orders_if -> controller [style=dashed, arrowhead=none, label="delegation"];

  controller -> auth_req [arrowhead=none, label="requires"];
  auth_req -> auth_if [arrowhead=none, label="authorize"];
  auth_if -> guard [arrowhead=none, label="provided"];

  controller -> app_req [arrowhead=none, label="requires"];
  app_req -> app_if [arrowhead=none, label="application service"];
  app_if -> service [style=dashed, arrowhead=none, label="delegation"];
  service -> confirm [arrowhead=none, label="confirm draft"];

  confirm -> jdbc_req [arrowhead=none, label="requires"];
  jdbc_req -> jdbc_if [arrowhead=none, label="JDBC repository"];
  jdbc_if -> db [arrowhead=none, label="provided"];

  confirm -> kitchen_req [arrowhead=none, label="requires"];
  kitchen_req -> kitchen_if [arrowhead=none, label="/internal/kitchen"];
  kitchen_if -> kitchen_controller [arrowhead=none, label="provided"];
  kitchen_controller -> kitchen_service [arrowhead=none];

  confirm -> event_req [arrowhead=none, label="requires"];
  event_req -> event_if [arrowhead=none, label="DomainEventPublisher"];
  event_if -> outbox [style=dashed, arrowhead=none, label="delegation"];
  outbox -> db [arrowhead=none, label="outbox_events"];
  relay -> db [style=dashed, arrowhead=none, label="poll"];
  relay -> amqp_req [arrowhead=none, label="requires"];
  amqp_req -> amqp_if [arrowhead=none, label="AMQP publish"];
  amqp_if -> rabbit [arrowhead=none, label="provided"];
}
