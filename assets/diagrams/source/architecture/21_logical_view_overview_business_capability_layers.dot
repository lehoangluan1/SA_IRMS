digraph G {
  graph [
    rankdir=TB,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=0.98,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Logical Capability Layers of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.6, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.2];

  subgraph cluster_model {
    label="<<model>> Logical View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_experience {
      label="<<package>> Experience Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      reservation [label="Reservation and Seating"];
      ordering [label="Ordering"];
      kitchen [label="Kitchen Coordination"];
      billing [label="Billing and Settlement"];
    }

    subgraph cluster_reference {
      label="<<package>> Reference Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      menu [label="Menu Management"];
      inventory [label="Inventory Monitoring"];
    }

    subgraph cluster_governance {
      label="<<package>> Governance Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      iam [label="Identity and Access Control"];
      audit [label="Audit and Compliance"];
    }

    subgraph cluster_insight {
      label="<<package>> Insight and Integration Layer";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      notification [label="Notification Integration"];
      reporting [label="Reporting and Analytics"];
    }
  }

  reservation -> ordering [label="table context"];
  ordering -> kitchen [label="confirmed order"];
  ordering -> billing [label="billable snapshot"];
  kitchen -> billing [label="served facts"];

  menu -> ordering [label="availability and pricing"];
  inventory -> menu [label="hide or restore items"];
  inventory -> notification [label="low-stock alert"];

  iam -> reservation [label="authorize"];
  iam -> ordering [label="authorize"];
  iam -> billing [label="authorize"];
  ordering -> audit [label="override trace"];
  billing -> audit [label="refund trace"];

  reservation -> reporting [label="occupancy facts"];
  ordering -> reporting [label="sales facts"];
  kitchen -> reporting [label="prep latency"];
  billing -> reporting [label="settlement facts"];
  billing -> notification [label="receipt event"];
}
