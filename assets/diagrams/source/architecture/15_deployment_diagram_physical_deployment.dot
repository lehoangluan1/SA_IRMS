digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad=0.45,
    nodesep=0.55,
    ranksep=1.0,
    splines=polyline,
    fontname="DejaVu Sans",
    labelloc="t",
    label="Deployment Diagram - Physical Deployment"
  ];

  node [fontname="DejaVu Sans", fontsize=10.8, color="#334155", penwidth=1.1, style="filled"];
  edge [fontname="DejaVu Sans", fontsize=9.6, color="#64748B", penwidth=1.0, arrowsize=0.72];

  browser [shape=box3d, fillcolor="#FEFCE8", label="«device»
Restaurant Client Device
(browser / tablet / terminal)"];

  subgraph cluster_edge {
    label="Application Edge Node";
    color="#CBD5E1";
    style="rounded,filled";
    fillcolor="#F8FAFC";
    edgehost [shape=box3d, fillcolor="#ECFEFF", label="«device»
Edge Host"];
    nginx [shape=box3d, fillcolor="#FFF7ED", color="#FDBA74", label="«executionEnvironment»
Nginx Reverse Proxy"];
    ui    [shape=note, fillcolor="#FFFFFF", label="«artifact»
Unified Web Client Assets"];
    edgehost -> nginx [arrowhead=none, color="#94A3B8"];
    nginx -> ui [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_appserver {
    label="Backend Application Node";
    color="#93C5FD";
    style="rounded,filled";
    fillcolor="#EFF6FF";
    apphost [shape=box3d, fillcolor="#ECFEFF", label="«device»
Backend IRMS Application Server"];
    apprt [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»
Spring Boot IRMS Runtime"];
    api   [shape=note, fillcolor="#FFFFFF", label="«artifact»
IRMS Web/API Artifact"];
    core  [shape=note, fillcolor="#FFFFFF", label="«artifact»
IRMS Core Service Modules"];
    adapt [shape=note, fillcolor="#FFFFFF", label="«artifact»
IRMS Integration Adapters"];
    apphost -> apprt [arrowhead=none, color="#94A3B8"];
    apprt -> api [arrowhead=none, color="#94A3B8"];
    apprt -> core [arrowhead=none, color="#94A3B8"];
    apprt -> adapt [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_worker {
    label="Asynchronous Worker Node";
    color="#C4B5FD";
    style="rounded,filled";
    fillcolor="#F5F3FF";
    workerh [shape=box3d, fillcolor="#ECFEFF", label="«device»
Background Worker Host"];
    workrt [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»
Worker Runtime"];
    jobs1  [shape=note, fillcolor="#FFFFFF", label="«artifact»
Notification Job Handler"];
    jobs2  [shape=note, fillcolor="#FFFFFF", label="«artifact»
Receipt Print Handler"];
    jobs3  [shape=note, fillcolor="#FFFFFF", label="«artifact»
Projection Refresh Handler"];
    workerh -> workrt [arrowhead=none, color="#94A3B8"];
    workrt -> jobs1 [arrowhead=none, color="#94A3B8"];
    workrt -> jobs2 [arrowhead=none, color="#94A3B8"];
    workrt -> jobs3 [arrowhead=none, color="#94A3B8"];
  }

  subgraph cluster_db {
    label="Data Node";
    color="#FCA5A5";
    style="rounded,filled";
    fillcolor="#FEF2F2";
    dbhost [shape=box3d, fillcolor="#ECFEFF", label="«device»
Relational Database Server"];
    pg [shape=box3d, fillcolor="#F8FAFC", label="«executionEnvironment»
PostgreSQL"];
    schema1 [shape=note, fillcolor="#FFFFFF", label="«artifact»
Operational Schema"];
    schema2 [shape=note, fillcolor="#FFFFFF", label="«artifact»
Reporting Views"];
    dbhost -> pg [arrowhead=none, color="#94A3B8"];
    pg -> schema1 [arrowhead=none, color="#94A3B8"];
    pg -> schema2 [arrowhead=none, color="#94A3B8"];
  }

  printer [shape=box3d, fillcolor="#ECFEFF", label="«device»
Receipt Printer Gateway"];

  subgraph cluster_external {
    label="External Service Providers";
    color="#CBD5E1";
    style="rounded,dashed";
    pay [shape=box3d, fillcolor="#F8FAFC", label="«external»
Payment Gateway Service"];
    ns  [shape=box3d, fillcolor="#F8FAFC", label="«external»
Notification Service"];
  }

  browser -> edgehost [label="HTTPS"];
  edgehost -> apphost [label="HTTP / JSON"];
  apphost -> dbhost [label="JDBC / SQL"];
  apphost -> workerh [style=dashed, label="job dispatch"];
  workerh -> dbhost [label="projection / job state"];
  apphost -> pay [label="HTTPS"];
  workerh -> ns [label="HTTPS"];
  workerh -> printer [label="print connector"];

  edgehost -> apphost [weight=8];
  apphost -> workerh [style=invis, weight=8];
  workerh -> dbhost [style=invis, weight=8];
  dbhost -> pay [style=invis, weight=8];
}
