digraph G {
  rankdir=LR;

  graph [bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.7, splines=ortho, fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans", fontsize=11, color="#334155"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.7];

  node [shape=box3d, style="filled", fillcolor="#ECFEFF", fontname="DejaVu Sans", fontsize=11, color="#334155"];
  subgraph cluster_internal {
    label="Restaurant Internal Network"; labelloc=t; fontsize=14; style="rounded"; color="#94A3B8"; penwidth=1.2;
    subgraph cluster_foh {
      label="Front-of-House Devices"; color="#CBD5E1"; style="rounded";
      "Host_Tablet" [label="«device»
Host Tablet", fillcolor="#FEFCE8"];
      "Server_Tablet" [label="«device»
Server Tablet", fillcolor="#FEFCE8"];
      "Cashier_Terminal" [label="«device»
Cashier Terminal", fillcolor="#FEFCE8"];
    }
    subgraph cluster_boh {
      label="Back-of-House Devices"; color="#CBD5E1"; style="rounded";
      "Kitchen_Display_Station" [label="«device»
Kitchen Display Station", fillcolor="#FEFCE8"];
      "Manager_Console" [label="«device»
Manager Console", fillcolor="#FEFCE8"];
    }
    subgraph cluster_app_server {
      label="Application Tier"; color="#CBD5E1"; style="rounded";
      "APP" [label="«device»
IRMS Application Server"];
      "APP_RUNTIME" [label="«executionEnvironment»
IRMS Runtime", fillcolor="#F8FAFC"];
      "ART_WEB" [label="«artifact»
irms-web-api.war", shape=note, fillcolor="#F8FAFC"];
      "ART_CORE" [label="«artifact»
irms-core-services.jar", shape=note, fillcolor="#F8FAFC"];
      "ART_ADAPTERS" [label="«artifact»
irms-adapters.jar", shape=note, fillcolor="#F8FAFC"];
      "APP" -> "APP_RUNTIME" [arrowhead=none];
      "APP_RUNTIME" -> "ART_WEB" [arrowhead=none];
      "APP_RUNTIME" -> "ART_CORE" [arrowhead=none];
      "APP_RUNTIME" -> "ART_ADAPTERS" [arrowhead=none];
    }
    subgraph cluster_worker {
      label="Asynchronous Processing Tier"; color="#CBD5E1"; style="rounded";
      "WORKER" [label="«device»
Background Worker Host"];
      "WORKER_RUNTIME" [label="«executionEnvironment»
Worker Runtime", fillcolor="#F8FAFC"];
      "ART_NOTIFY" [label="«artifact»
notification-worker.jar", shape=note, fillcolor="#F8FAFC"];
      "ART_PRINT" [label="«artifact»
print-worker.jar", shape=note, fillcolor="#F8FAFC"];
      "ART_PROJ" [label="«artifact»
projection-refresh-worker.jar", shape=note, fillcolor="#F8FAFC"];
      "WORKER" -> "WORKER_RUNTIME" [arrowhead=none];
      "WORKER_RUNTIME" -> "ART_NOTIFY" [arrowhead=none];
      "WORKER_RUNTIME" -> "ART_PRINT" [arrowhead=none];
      "WORKER_RUNTIME" -> "ART_PROJ" [arrowhead=none];
    }
    subgraph cluster_db {
      label="Data Tier"; color="#CBD5E1"; style="rounded";
      "DB_SERVER" [label="«device»
Database Server"];
      "DBMS" [label="«executionEnvironment»
PostgreSQL", fillcolor="#F8FAFC"];
      "SCHEMA" [label="«artifact»
irms_operational_schema", shape=note, fillcolor="#F8FAFC"];
      "DB_SERVER" -> "DBMS" [arrowhead=none];
      "DBMS" -> "SCHEMA" [arrowhead=none];
    }
    "PRN" [label="«device»
Receipt Printer Gateway"];
  }
  subgraph cluster_external {
    label="External Services"; color="#94A3B8"; style="rounded"; penwidth=1.2;
    "PG" [label="«device»
Payment Gateway Service"];
    "NS" [label="«device»
Notification Service"];
  }
  edge [arrowhead=open];
  "Host_Tablet" -> "APP" [label="HTTPS"];
  "Server_Tablet" -> "APP" [label="HTTPS"];
  "Cashier_Terminal" -> "APP" [label="HTTPS"];
  "Kitchen_Display_Station" -> "APP" [label="HTTPS / internal API"];
  "Manager_Console" -> "APP" [label="HTTPS"];
  "APP" -> "DB_SERVER" [label="JDBC / SQL"];
  "APP" -> "WORKER" [label="job dispatch"];
  "WORKER" -> "DB_SERVER" [label="projection / job state"];
  "APP" -> "PRN" [label="print connector"];
  "APP" -> "PG" [label="HTTPS"];
  "WORKER" -> "NS" [label="HTTPS"];
}
