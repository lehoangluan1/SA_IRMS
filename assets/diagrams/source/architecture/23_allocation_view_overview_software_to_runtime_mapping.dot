digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.68,
    ranksep=1.00,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Deployment Diagram - Allocation View Overview of IRMS"
  ];

  node [fontname="DejaVu Sans", fontsize=9.3, color="#64748B", penwidth=1.0, style="filled", fillcolor="#FFFFFF"];
  edge [fontname="DejaVu Sans", fontsize=8.2, color="#64748B", penwidth=0.9, arrowhead=vee];

  host [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nHost Tablet"];
  server [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nServer Tablet"];
  kitchen_display [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nKitchen Display"];
  cashier [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nCashier Terminal"];
  manager [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nManager Console"];

  api_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nAPI Server\n\n<<artifact>> Reservation & Seating Service\n<<artifact>> Ordering & Menu Service\n<<artifact>> Kitchen Coordination Service\n<<artifact>> Billing & Settlement Service\n<<artifact>> Inventory Monitoring Service\n<<artifact>> IAM & Audit Service"];
  worker_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nBackground Worker\n\n<<artifact>> Outbox Dispatcher\n<<artifact>> Notification Worker\n<<artifact>> Projection Worker\n<<artifact>> Receipt Job Processor"];
  query_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nReporting Query Node\n\n<<artifact>> Reporting Service"];

  operational_db [shape=cylinder, fillcolor="#F8FBFF", label="<<database>>\nOperational RDBMS\nreservations, orders,\nbills, stock, users, audit"];
  read_model [shape=cylinder, fillcolor="#F8FBFF", label="<<database>>\nReporting Read Model"];
  outbox [shape=cylinder, fillcolor="#F8FBFF", label="<<queue>>\nOutbox and Job Queue"];

  payment_gateway [shape=box, style="rounded,filled", fillcolor="#F8FBFF", label="<<external system>>\nPayment Gateway"];
  receipt_printer [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nReceipt Printer"];
  notification_service [shape=box, style="rounded,filled", fillcolor="#F8FBFF", label="<<external system>>\nNotification Service"];

  { rank=same; host; server; kitchen_display; cashier; manager; }
  { rank=same; api_node; worker_node; query_node; }
  { rank=same; operational_db; outbox; read_model; }

  host -> api_node [label="HTTPS"];
  server -> api_node [label="HTTPS"];
  kitchen_display -> api_node [label="HTTPS"];
  cashier -> api_node [label="HTTPS"];
  manager -> api_node [label="HTTPS"];

  api_node -> operational_db [label="transactional read and write"];
  api_node -> outbox [label="write outbox events"];
  worker_node -> outbox [label="consume events and jobs"];
  worker_node -> read_model [label="refresh reporting projections"];
  query_node -> read_model [label="query reports"];

  api_node -> payment_gateway [label="payment adapter API"];
  worker_node -> receipt_printer [label="receipt printer adapter"];
  worker_node -> notification_service [label="notification adapter"];
}
