digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.68,
    ranksep=1.00,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Deployment Diagram - Allocation View Overview of IRMS"
  ];

  node [fontname="DejaVu Sans", fontsize=9.3, color="#64748B", penwidth=1.0, style="filled", fillcolor="#FFFFFF"];
  edge [fontname="DejaVu Sans", fontsize=8.2, color="#64748B", penwidth=0.9, arrowhead=vee];

  host [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nHost Tablet"];
  server [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nServer Tablet"];
  kitchen_display [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nKitchen Display"];
  cashier [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nCashier Terminal"];
  manager [shape=box3d, fillcolor="#F8FBFF", label="<<device>>\nManager Console"];

  frontend_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nfrontend container\n\n<<artifact>> React UI\n<<artifact>> Nitro API Proxy"];
  gateway_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\napi-gateway container\n\n<<artifact>> ApiGatewayApplication\n<<artifact>> GatewayProxyController"];
  service_nodes [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nSpring Boot service containers\n\n<<artifact>> ordering-service\n<<artifact>> kitchen-service\n<<artifact>> billing-service\n<<artifact>> reservation-service\n<<artifact>> inventory-service\n<<artifact>> notification-service\n<<artifact>> reporting-service\n<<artifact>> identity-audit-service"];
  migration_node [shape=box3d, fillcolor="#EFF6FF", label="<<node>>\nirms-migration container\n\n<<artifact>> MigrationApplication"];

  operational_db [shape=cylinder, fillcolor="#F8FBFF", label="<<database>>\nPostgreSQL container\nshared operational schema"];
  rabbitmq [shape=box3d, fillcolor="#F8FBFF", label="<<node>>\nRabbitMQ container\nbroker queues"];
  read_model [shape=cylinder, fillcolor="#F8FBFF", label="<<artifact>>\nReporting tables and views"];
  outbox [shape=cylinder, fillcolor="#F8FBFF", label="<<artifact>>\noutbox_events and processed_events"];

  { rank=same; host; server; kitchen_display; cashier; manager; }
  { rank=same; frontend_node; gateway_node; service_nodes; migration_node; }
  { rank=same; operational_db; rabbitmq; outbox; read_model; }

  host -> frontend_node [label="HTTP"];
  server -> frontend_node [label="HTTP"];
  kitchen_display -> frontend_node [label="HTTP"];
  cashier -> frontend_node [label="HTTP"];
  manager -> frontend_node [label="HTTP"];

  frontend_node -> gateway_node [label="/api proxy"];
  gateway_node -> service_nodes [label="REST routing"];

  service_nodes -> operational_db [label="JDBC"];
  service_nodes -> outbox [label="write / claim events"];
  service_nodes -> rabbitmq [label="publish / consume"];
  service_nodes -> read_model [label="refresh and query"];
  migration_node -> operational_db [label="Flyway migrations"];
}
