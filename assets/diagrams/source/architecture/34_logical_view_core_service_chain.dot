digraph G {
  graph [
    rankdir=LR,
    newrank=true,
    compound=true,
    bgcolor="white",
    pad=0.34,
    nodesep=0.58,
    ranksep=1.05,
    splines=ortho,
    fontname="DejaVu Sans",
    labelloc="t",
    label="UML Package Diagram - Core Logical Service Chain of IRMS"
  ];

  node [shape=folder, style="filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.0, fontname="DejaVu Sans", fontsize=9.6, margin="0.14,0.08"];
  edge [style=dashed, arrowhead=vee, color="#64748B", penwidth=0.9, fontname="DejaVu Sans", fontsize=8.2];

  subgraph cluster_model {
    label="<<model>> Logical View";
    color="#94A3B8";
    penwidth=1.1;
    style="rounded";

    subgraph cluster_reference {
      label="<<package>> Reference Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      menu [label="Menu Management"];
      inventory [label="Inventory Monitoring"];
    }

    subgraph cluster_core {
      label="<<package>> Core Service Chain";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      seating [label="Reservation and Seating"];
      ordering [label="Ordering"];
      kitchen [label="Kitchen Coordination"];
      billing [label="Billing and Settlement"];
    }

    subgraph cluster_governance {
      label="<<package>> Governance Packages";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      iam [label="Identity and Access Control"];
      audit [label="Audit and Compliance"];
    }

    subgraph cluster_observation {
      label="<<package>> Observation and Integration";
      color="#BFDBFE";
      style="rounded,filled";
      fillcolor="#F8FBFF";
      facts [label="Operational Facts"];
      reporting [label="Reporting and Analytics"];
      notification [label="Notification Integration"];
    }
  }

  seating -> ordering [label="table context"];
  menu -> ordering [label="item rules"];
  ordering -> kitchen [label="confirmed items"];
  ordering -> billing [label="billable snapshot"];
  kitchen -> billing [label="served facts"];
  billing -> seating [label="session closure"];

  inventory -> ordering [label="recipe and stock context"];
  inventory -> notification [label="low-stock alert"];

  iam -> ordering [label="authorize"];
  iam -> billing [label="authorize"];

  seating -> facts [label="reservation events"];
  ordering -> facts [label="order events"];
  kitchen -> facts [label="kitchen events"];
  billing -> facts [label="settlement events"];

  facts -> audit [label="traceability"];
  facts -> reporting [label="analytics feed"];
  facts -> notification [label="operational notice"];
}
