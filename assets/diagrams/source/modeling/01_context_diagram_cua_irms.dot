digraph G {
  graph [
    layout=neato,
    splines=polyline,
    outputorder=nodesfirst,
    bgcolor="white",
    pad=0.35,
    fontname="DejaVu Sans",
    labelloc="t",
    label="System Context Diagram - IRMS",
    imagepath="C:/Users/LUAN/Downloads/SA_BTL/assets/images/misc"
  ];

  node [
    fontname="DejaVu Sans",
    fontsize=10.0,
    color="#475569",
    penwidth=1.10,
    pin=true,
    shape=box,
    style="filled",
    fillcolor="#ECFDF5",
    margin="0.12,0.08"
  ];

  edge [
    fontname="DejaVu Sans",
    fontsize=8.1,
    color="#475569",
    penwidth=0.95,
    arrowsize=0.72
  ];

  irms [
    shape=ellipse,
    style="filled",
    fillcolor="#E5E7EB",
    color="#0F766E",
    penwidth=1.40,
    width=4.1,
    height=4.1,
    fixedsize=true,
    pos="620,420!",
    label="0\nIRMS\nIntegrated Restaurant\nManagement System"
  ];

  customer [shape=none, image="actor_stickman.png", label="Customer", labelloc=b, imagepos=tc, imagescale=true, pos="620,790!"];
  host [shape=none, image="actor_stickman.png", label="Host", labelloc=b, imagepos=tc, imagescale=true, pos="110,660!"];
  server [shape=none, image="actor_stickman.png", label="Server", labelloc=b, imagepos=tc, imagescale=true, pos="110,500!"];
  kitchen [shape=none, image="actor_stickman.png", label="Chef", labelloc=b, imagepos=tc, imagescale=true, pos="110,340!"];
  cashier [shape=none, image="actor_stickman.png", label="Cashier", labelloc=b, imagepos=tc, imagescale=true, pos="110,180!"];

  manager [shape=none, image="actor_stickman.png", label="Manager", labelloc=b, imagepos=tc, imagescale=true, pos="1130,660!"];
  admin [shape=none, image="actor_stickman.png", label="System Administrator", labelloc=b, imagepos=tc, imagescale=true, pos="1130,500!"];

  customer -> irms [
    tailport=s,
    headport=n,
    label="reservation request,\narrival update,\nparty preferences"
  ];
  irms -> customer [
    tailport=ne,
    headport=se,
    label="booking confirmation,\nwaitlist notice,\ne-receipt reference"
  ];

  host -> irms [
    tailport=e,
    headport=nw,
    label="check-in action,\nwaitlist operation,\ntable assignment confirmation"
  ];
  irms -> host [
    tailport=w,
    headport=e,
    label="reservation board,\nqueue status,\ncandidate table list"
  ];

  server -> irms [
    tailport=e,
    headport=w,
    label="order entry,\nmodifier note,\nserve completion"
  ];
  irms -> server [
    tailport=sw,
    headport=se,
    label="active table session,\nitem availability,\nbill readiness"
  ];

  kitchen -> irms [
    tailport=e,
    headport=sw,
    label="prep status,\ndish ready event,\nstock-out signal"
  ];
  irms -> kitchen [
    tailport=w,
    headport=e,
    label="kitchen ticket,\npriority update,\ncancel or amend order"
  ];

  cashier -> irms [
    tailport=e,
    headport=sw,
    label="bill split choice,\npayment input,\nmanual cash settlement"
  ];
  irms -> cashier [
    tailport=sw,
    headport=ne,
    label="bill total,\ntransaction state,\nclosure eligibility"
  ];

  manager -> irms [
    tailport=w,
    headport=ne,
    label="menu change,\nstock rule update,\nreport query"
  ];
  irms -> manager [
    tailport=e,
    headport=w,
    label="revenue snapshot,\nlow-stock alert,\noperations dashboard"
  ];

  admin -> irms [
    tailport=w,
    headport=e,
    label="role update,\npolicy change,\naudit request"
  ];
  irms -> admin [
    tailport=se,
    headport=sw,
    label="access matrix,\naudit trail,\ncompliance evidence"
  ];
}
