digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.65, ranksep=0.9, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Reservation Module Structure"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  ReservationController [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>ReservationController</B></TD></TR>

      <TR><TD ALIGN="LEFT">- reservationService: ReservationService<BR ALIGN="LEFT"/>- permissionGuard: PermissionGuard</TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ overview(date, request)<BR ALIGN="LEFT"/>+ createReservation(body, request)<BR ALIGN="LEFT"/>+ checkIn(reservationId, body, request)<BR ALIGN="LEFT"/>+ noShow(reservationId, request)</TD></TR>

    </TABLE>

  >];
  TableController [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>TableController</B></TD></TR>
      <TR><TD ALIGN="LEFT">- reservationService: ReservationService</TD></TR>
      <TR><TD ALIGN="LEFT">+ createTable(body, request)<BR ALIGN="LEFT"/>+ updateTable(tableId, body, request)<BR ALIGN="LEFT"/>+ updateStatus(tableId, body, request)</TD></TR>
    </TABLE>
  >];
  WaitlistController [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>WaitlistController</B></TD></TR>
      <TR><TD ALIGN="LEFT">- reservationService: ReservationService</TD></TR>
      <TR><TD ALIGN="LEFT">+ createWaitlist(body, request)<BR ALIGN="LEFT"/>+ notifyWaitlist(waitlistEntryId, request)<BR ALIGN="LEFT"/>+ seatWaitlist(waitlistEntryId, request)</TD></TR>
    </TABLE>
  >];
  ReservationService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>ReservationService</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ load(date)<BR ALIGN="LEFT"/>+ recommend(date, time, party)<BR ALIGN="LEFT"/>+ createReservation(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ checkIn(reservationId, request, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  ReservationCheckInService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>ReservationCheckInService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ checkIn(reservationId, request, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  ReservationWaitlistService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>ReservationWaitlistService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createWaitlistEntry(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ notifyWaitlist(waitlistEntryId, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ seatWaitlist(waitlistEntryId, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  ReservationSeatingMediator [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;workflow&gt;&gt;</I><BR/><B>ReservationSeatingMediator</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ seatReservation(reservationId, tableId, correlationId)<BR ALIGN="LEFT"/>+ handleWaitlistUpdated(event)<BR ALIGN="LEFT"/>+ updateWaitlist(waitlistEntryId, status, correlationId)</TD></TR>
    </TABLE>
  >];
  ReservationLifecycleCommandPort [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>ReservationLifecycleCommandPort</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createReservation(...)<BR ALIGN="LEFT"/>+ updateReservation(...)<BR ALIGN="LEFT"/>+ confirmReservation(reservationId)<BR ALIGN="LEFT"/>+ markReservationNoShow(reservationId)</TD></TR>
    </TABLE>
  >];
  ReservationTableCommandPort [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>ReservationTableCommandPort</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createTable(...)<BR ALIGN="LEFT"/>+ updateTable(...)<BR ALIGN="LEFT"/>+ updateTableStatus(tableId, targetStatus)</TD></TR>
    </TABLE>
  >];
  JdbcReservationLifecycleCommandAdapter [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;repository adapter&gt;&gt;</I><BR/><B>JdbcReservationLifecycleCommandAdapter</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createReservation(...)<BR ALIGN="LEFT"/>+ confirmReservation(reservationId)<BR ALIGN="LEFT"/>+ markReservationNoShow(reservationId)</TD></TR>
    </TABLE>
  >];
  JdbcReservationTableCommandAdapter [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;repository adapter&gt;&gt;</I><BR/><B>JdbcReservationTableCommandAdapter</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createTable(...)<BR ALIGN="LEFT"/>+ updateTable(...)<BR ALIGN="LEFT"/>+ updateTableStatus(tableId, targetStatus)</TD></TR>
    </TABLE>
  >];
  ReservationViews [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;view records&gt;&gt;</I><BR/><B>ReservationViews</B></TD></TR>
      <TR><TD ALIGN="LEFT">ReservationOverview<BR ALIGN="LEFT"/>ReservationView<BR ALIGN="LEFT"/>WaitlistView<BR ALIGN="LEFT"/>TableView<BR ALIGN="LEFT"/>RecommendedTable</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];

  ReservationController -> ReservationService [arrowhead=none];
  TableController -> ReservationService [arrowhead=none];
  WaitlistController -> ReservationService [arrowhead=none];
  ReservationService -> ReservationCheckInService [arrowhead=none];
  ReservationService -> ReservationWaitlistService [arrowhead=none];
  ReservationCheckInService -> ReservationLifecycleCommandPort [style=dashed, arrowhead=open];
  ReservationCheckInService -> ReservationSeatingMediator [style=dashed, arrowhead=open];
  ReservationWaitlistService -> ReservationSeatingMediator [style=dashed, arrowhead=open];
  ReservationService -> ReservationViews [style=dashed, arrowhead=open];
  JdbcReservationLifecycleCommandAdapter -> ReservationLifecycleCommandPort [style=dashed, arrowhead=empty];
  JdbcReservationTableCommandAdapter -> ReservationTableCommandPort [style=dashed, arrowhead=empty];
}
