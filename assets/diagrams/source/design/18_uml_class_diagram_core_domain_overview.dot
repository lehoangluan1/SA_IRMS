digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.7, ranksep=1.0, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Backend Services and Extension Points"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  subgraph cluster_entry {
    label="Runtime entrypoints"; color="#BFDBFE"; style="rounded";
    ApiGatewayApplication [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;SpringBootApplication&gt;&gt;</I><BR/><B>ApiGatewayApplication</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ main(args)</TD></TR>
      </TABLE>
    >];
    OrderingServiceApplication [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;SpringBootApplication&gt;&gt;</I><BR/><B>OrderingServiceApplication</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ main(args)</TD></TR>
      </TABLE>
    >];
    KitchenServiceApplication [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;SpringBootApplication&gt;&gt;</I><BR/><B>KitchenServiceApplication</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ main(args)</TD></TR>
      </TABLE>
    >];
    BillingServiceApplication [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;SpringBootApplication&gt;&gt;</I><BR/><B>BillingServiceApplication</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ main(args)</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_services {
    label="Application services"; color="#BFDBFE"; style="rounded";
    OrdersService [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrdersService</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ load(sessionId)<BR ALIGN="LEFT"/>+ createOrder(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ confirmDraftOrder(orderId, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ cancelOrder(orderId, reason, actor, correlationId, metadata)</TD></TR>
      </TABLE>
    >];
    KitchenService [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenService</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ load(stationFilter)<BR ALIGN="LEFT"/>+ updateTicketStatus(ticketId, targetStatus, actor, correlationId)<BR ALIGN="LEFT"/>+ updateItemStatus(ticketItemId, targetStatus, reason, actor, correlationId, metadata)</TD></TR>
      </TABLE>
    >];
    BillingService [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>BillingService</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ createBill(tableSessionId)<BR ALIGN="LEFT"/>+ processPayment(billId, request, actor)<BR ALIGN="LEFT"/>+ issueReceipt(paymentId, request)<BR ALIGN="LEFT"/>+ refundPayment(paymentId, request, actor, correlationId, metadata)</TD></TR>
      </TABLE>
    >];
    ReservationService [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>ReservationService</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ load(date)<BR ALIGN="LEFT"/>+ createReservation(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ checkIn(reservationId, request, actor, correlationId, metadata)</TD></TR>
      </TABLE>
    >];
    InventoryService [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>InventoryService</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ load()<BR ALIGN="LEFT"/>+ createIngredient(request)<BR ALIGN="LEFT"/>+ updateIngredient(inventoryItemId, request, actorUserId, metadata)<BR ALIGN="LEFT"/>+ consumeForKitchenStart(orderItemId, actorUserId, correlationId)</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_shared {
    label="Shared platform"; color="#CBD5E1"; style="rounded";
    DomainEventPublisher [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>DomainEventPublisher</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ publish(event)</TD></TR>
      </TABLE>
    >];
    TransactionalOutboxPublisher [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>TransactionalOutboxPublisher</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ publish(event)</TD></TR>
      </TABLE>
    >];
    RabbitMqOutboxRelay [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>RabbitMqOutboxRelay</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ relayPendingEvents()</TD></TR>
      </TABLE>
    >];
    ManualAckConsumerSupport [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>ManualAckConsumerSupport</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ handle(message, channel, consumerName, handler)</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_ports {
    label="Ports and adapters"; color="#CBD5E1"; style="rounded";
    PaymentGateway [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>PaymentGateway</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ supports(method)<BR ALIGN="LEFT"/>+ authorize(method, amount, amountReceived, paymentId)<BR ALIGN="LEFT"/>+ refund(payment, amount, refundId)</TD></TR>
      </TABLE>
    >];
    BillSplitStrategy [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>BillSplitStrategy</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ method()<BR ALIGN="LEFT"/>+ split(context, request)</TD></TR>
      </TABLE>
    >];
    ReorderRecommendationStrategy [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>ReorderRecommendationStrategy</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ compute(stockLevel)</TD></TR>
      </TABLE>
    >];
    NotificationChannelAdapter [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
        <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>NotificationChannelAdapter</B></TD></TR>
        <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
        <TR><TD ALIGN="LEFT">+ channel()<BR ALIGN="LEFT"/>+ validate(command)</TD></TR>
      </TABLE>
    >];
  }

  OrdersService -> DomainEventPublisher [style=dashed, arrowhead=open];
  KitchenService -> DomainEventPublisher [style=dashed, arrowhead=open];
  BillingService -> DomainEventPublisher [style=dashed, arrowhead=open];
  ReservationService -> DomainEventPublisher [style=dashed, arrowhead=open];
  InventoryService -> DomainEventPublisher [style=dashed, arrowhead=open];

  TransactionalOutboxPublisher -> DomainEventPublisher [style=dashed, arrowhead=empty];
  RabbitMqOutboxRelay -> DomainEventPublisher [style=dashed, arrowhead=open];
  BillingService -> PaymentGateway [style=dashed, arrowhead=open];
  BillingService -> BillSplitStrategy [style=dashed, arrowhead=open];
  InventoryService -> ReorderRecommendationStrategy [style=dashed, arrowhead=open];
}
