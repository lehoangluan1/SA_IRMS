
digraph G {

graph [bgcolor="#F3F4F6", pad="0.25", nodesep="0.55", ranksep="0.9", splines=ortho, fontname="Helvetica"];
node [fontname="Helvetica", shape=plaintext];
edge [fontname="Helvetica", color="#5B6B8C", penwidth=1.0, arrowsize=0.7];

labelloc="t";
label="UML Class Diagram - Core Domain Overview";
rankdir=LR;

subgraph cluster_res {
 label="Reservation & Seating"; color="#9BB5FF"; style="rounded";
 Reservation [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>Reservation</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+reservationId: UUID<BR ALIGN='LEFT'/>+channel: ReservationChannel<BR ALIGN='LEFT'/>+status: ReservationStatus<BR ALIGN='LEFT'/>+arrivalTime: DateTime</TD></TR>
</TABLE>
>];
 TableSession [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>TableSession</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+sessionId: UUID<BR ALIGN='LEFT'/>+guestCount: int<BR ALIGN='LEFT'/>+status: TableSessionStatus</TD></TR>
</TABLE>
>];
}

subgraph cluster_order {
 label="Ordering & Kitchen"; color="#9BB5FF"; style="rounded";
 Order [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>Order</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+orderId: UUID<BR ALIGN='LEFT'/>+status: OrderStatus<BR ALIGN='LEFT'/>+confirmedAt: DateTime</TD></TR>
</TABLE>
>];
 KitchenTicket [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>KitchenTicket</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+ticketId: UUID<BR ALIGN='LEFT'/>+station: String<BR ALIGN='LEFT'/>+status: KitchenTicketStatus</TD></TR>
</TABLE>
>];
}

subgraph cluster_bill {
 label="Billing & Settlement"; color="#9BB5FF"; style="rounded";
 Bill [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>Bill</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+billId: UUID<BR ALIGN='LEFT'/>+status: BillStatus<BR ALIGN='LEFT'/>+grandTotal: Money</TD></TR>
</TABLE>
>];
 Payment [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>Payment</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+paymentId: UUID<BR ALIGN='LEFT'/>+amount: Money<BR ALIGN='LEFT'/>+status: PaymentStatus</TD></TR>
</TABLE>
>];
}

subgraph cluster_inv {
 label="Inventory & Menu"; color="#9BB5FF"; style="rounded";
 MenuItem [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>MenuItem</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+menuItemId: UUID<BR ALIGN='LEFT'/>+name: String<BR ALIGN='LEFT'/>+basePrice: Money</TD></TR>
</TABLE>
>];
 InventoryItem [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>InventoryItem</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+inventoryItemId: UUID<BR ALIGN='LEFT'/>+onHand: Decimal<BR ALIGN='LEFT'/>+threshold: Decimal</TD></TR>
</TABLE>
>];
}

subgraph cluster_gov {
 label="Identity, Audit & Reporting"; color="#9BB5FF"; style="rounded";
 User [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>User</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+userId: UUID<BR ALIGN='LEFT'/>+username: String<BR ALIGN='LEFT'/>+status: UserStatus</TD></TR>
</TABLE>
>];
 AuditLog [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>AuditLog</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+auditLogId: UUID<BR ALIGN='LEFT'/>+action: String<BR ALIGN='LEFT'/>+recordedAt: DateTime</TD></TR>
</TABLE>
>];
 ReportSnapshot [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#5B6B8C" BGCOLOR="#F7FAFF">
<TR><TD BGCOLOR="#DDE5F0"><B>ReportSnapshot</B></TD></TR>
<TR><TD ALIGN="LEFT" BALIGN="LEFT">+snapshotId: UUID<BR ALIGN='LEFT'/>+type: String<BR ALIGN='LEFT'/>+generatedAt: DateTime</TD></TR>
</TABLE>
>];
}

Reservation -> TableSession [label="1 to 0..1"];
TableSession -> Order [label="1 to many"];
Order -> KitchenTicket [label="1 to many"];
Order -> Bill [label="1 to 1"];
Bill -> Payment [label="1 to 0..*"];
Order -> MenuItem [style=dashed, label="references priced items"];
KitchenTicket -> InventoryItem [style=dashed, label="kitchen start triggers stock consumption"];
User -> AuditLog [label="records"];
Bill -> AuditLog [style=dashed, label="payment / refund trace"];
Order -> AuditLog [style=dashed, label="cancel / override trace"];
InventoryItem -> ReportSnapshot [style=dashed, label="inventory metrics"];
Bill -> ReportSnapshot [style=dashed, label="sales metrics"];
User -> ReportSnapshot [style=dashed, label="operator metrics"];
}
