digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.65, ranksep=0.9, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Ordering and Menu Module Structure"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  MenuItemController [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>MenuItemController</B></TD></TR>

      <TR><TD ALIGN="LEFT">- menuService: MenuService</TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ items(request)<BR ALIGN="LEFT"/>+ createItem(body, request)<BR ALIGN="LEFT"/>+ updateItem(menuItemId, body, request)<BR ALIGN="LEFT"/>+ toggleAvailability(menuItemId, request)</TD></TR>

    </TABLE>

  >];
  OrdersController [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>OrdersController</B></TD></TR>
      <TR><TD ALIGN="LEFT">- ordersService: OrdersService</TD></TR>
      <TR><TD ALIGN="LEFT">+ overview(sessionId, request)<BR ALIGN="LEFT"/>+ createOrder(body, request)<BR ALIGN="LEFT"/>+ confirmDraftOrder(orderId, request)</TD></TR>
    </TABLE>
  >];
  MenuService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>MenuService</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ load()<BR ALIGN="LEFT"/>+ createItem(request, actorUserId, correlationId, metadata)<BR ALIGN="LEFT"/>+ updateItem(menuItemId, request, actorUserId, correlationId, metadata)<BR ALIGN="LEFT"/>+ toggleAvailability(menuItemId, actorUserId, correlationId, metadata)<BR ALIGN="LEFT"/>+ applyPromotion(billId, code)</TD></TR>
    </TABLE>
  >];
  OrdersService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrdersService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ load(sessionId)<BR ALIGN="LEFT"/>+ createOrder(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ confirmDraftOrder(orderId, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderCreationService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrderCreationService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(request, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderMenuSelectionService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrderMenuSelectionService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ requireAvailableMenuItem(menuItemId, draftConfirmation)<BR ALIGN="LEFT"/>+ resolveModifierSelection(menuItemId, requestedOptionIds)<BR ALIGN="LEFT"/>+ insertModifierSelections(orderItemId, selectedOptions)<BR ALIGN="LEFT"/>+ loadModifierGroups(menuItemId)</TD></TR>
    </TABLE>
  >];
  ComboPricingPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>ComboPricingPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ componentUnitPrice(comboBasePrice, optionExtraPrice, totalSelectedUnits)</TD></TR>
    </TABLE>
  >];
  OrderStatusPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>OrderStatusPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ deriveOrderStatus(itemStatuses)</TD></TR>
    </TABLE>
  >];
  OrderItemStatusPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>OrderItemStatusPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ ensureDelayedItemCanBeSent(orderStatus, itemStatus)<BR ALIGN="LEFT"/>+ ensureItemCanBeCancelled(itemStatus, actor)</TD></TR>
    </TABLE>
  >];
  OrderRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>OrderRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(...)<BR ALIGN="LEFT"/>+ createOrderItem(...)<BR ALIGN="LEFT"/>+ confirmDraftOrder(...)</TD></TR>
    </TABLE>
  >];
  OrderQueryRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>OrderQueryRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">ResolvedMenuItemRow<BR ALIGN="LEFT"/>ResolvedModifierOptionRow<BR ALIGN="LEFT"/>DraftOrderRow<BR ALIGN="LEFT"/>OrderStateRow</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  JdbcOrderRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;repository adapter&gt;&gt;</I><BR/><B>JdbcOrderRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">implements OrderRepository</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  JdbcOrderQueryRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;repository adapter&gt;&gt;</I><BR/><B>JdbcOrderQueryRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">implements OrderQueryRepository</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  OrderCommands [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;command records&gt;&gt;</I><BR/><B>OrderCommands</B></TD></TR>
      <TR><TD ALIGN="LEFT">CreateOrderRequest<BR ALIGN="LEFT"/>OrderItemRequest<BR ALIGN="LEFT"/>ComboSelectionRequest</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  OrderViews [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;view records&gt;&gt;</I><BR/><B>OrderViews</B></TD></TR>
      <TR><TD ALIGN="LEFT">OrdersOverview<BR ALIGN="LEFT"/>MenuItemView<BR ALIGN="LEFT"/>OrderedItemView</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  MenuViews [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;view records&gt;&gt;</I><BR/><B>MenuViews</B></TD></TR>
      <TR><TD ALIGN="LEFT">MenuOverview<BR ALIGN="LEFT"/>CategoryView<BR ALIGN="LEFT"/>ComboView<BR ALIGN="LEFT"/>PromotionView</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];

  MenuItemController -> MenuService [arrowhead=none];
  OrdersController -> OrdersService [arrowhead=none];
  OrdersService -> OrderCreationService [arrowhead=none];
  OrderCreationService -> OrderMenuSelectionService [arrowhead=none];
  OrderMenuSelectionService -> OrderQueryRepository [style=dashed, arrowhead=open];
  OrderCreationService -> OrderRepository [style=dashed, arrowhead=open];
  OrderMenuSelectionService -> ComboPricingPolicy [style=dashed, arrowhead=open];
  OrdersService -> OrderStatusPolicy [style=dashed, arrowhead=open];
  OrdersService -> OrderItemStatusPolicy [style=dashed, arrowhead=open];
  JdbcOrderRepository -> OrderRepository [style=dashed, arrowhead=empty];
  JdbcOrderQueryRepository -> OrderQueryRepository [style=dashed, arrowhead=empty];
  OrdersController -> OrderCommands [style=dashed, arrowhead=open];
  OrdersService -> OrderViews [style=dashed, arrowhead=open];
  MenuService -> MenuViews [style=dashed, arrowhead=open];
}
