digraph G {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.45, ranksep=0.8, pad=0.4];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569", arrowsize=0.7];
  "Order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>Order</B></TD></TR>
<TR><TD ALIGN="LEFT">+orderId: UUID<BR ALIGN="LEFT"/>+status: OrderStatus<BR ALIGN="LEFT"/>+channel: OrderChannel<BR ALIGN="LEFT"/>+createdAt: DateTime<BR ALIGN="LEFT"/>+confirmedAt: DateTime</TD></TR>
</TABLE>>];
  "OrderItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>OrderItem</B></TD></TR>
<TR><TD ALIGN="LEFT">+orderItemId: UUID<BR ALIGN="LEFT"/>+quantity: int<BR ALIGN="LEFT"/>+unitPrice: Money<BR ALIGN="LEFT"/>+specialInstruction: String<BR ALIGN="LEFT"/>+allergyNote: String<BR ALIGN="LEFT"/>+lineStatus: OrderItemStatus</TD></TR>
</TABLE>>];
  "ModifierSelection" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>ModifierSelection</B></TD></TR>
<TR><TD ALIGN="LEFT">+selectionId: UUID<BR ALIGN="LEFT"/>+name: String<BR ALIGN="LEFT"/>+extraPrice: Money</TD></TR>
<TR><TD ALIGN="LEFT"> </TD></TR>
</TABLE>>];
  "MenuItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>MenuItem</B></TD></TR>
<TR><TD ALIGN="LEFT">+menuItemId: UUID<BR ALIGN="LEFT"/>+name: String<BR ALIGN="LEFT"/>+basePrice: Money<BR ALIGN="LEFT"/>+station: String<BR ALIGN="LEFT"/>+availability: ItemAvailability</TD></TR>
<TR><TD ALIGN="LEFT"> </TD></TR>
</TABLE>>];
  "KitchenTicket" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>KitchenTicket</B></TD></TR>
<TR><TD ALIGN="LEFT">+ticketId: UUID<BR ALIGN="LEFT"/>+station: String<BR ALIGN="LEFT"/>+priority: int<BR ALIGN="LEFT"/>+status: KitchenTicketStatus</TD></TR>
</TABLE>>];
  "KitchenTicketItem" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>KitchenTicketItem</B></TD></TR>
<TR><TD ALIGN="LEFT">+ticketItemId: UUID<BR ALIGN="LEFT"/>+quantity: int<BR ALIGN="LEFT"/>+status: KitchenTicketItemStatus</TD></TR>
</TABLE>>];
  "KitchenPriorityPolicy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>KitchenPriorityPolicy</B></TD></TR>
<TR><TD ALIGN="LEFT">+nextManualPriority(currentPriority)<BR ALIGN="LEFT"/>+score(priorityLabel)<BR ALIGN="LEFT"/>+automaticEscalation(...)</TD></TR>
</TABLE>>];
  "TableSession" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#334155" BGCOLOR="#F8FAFC">
<TR><TD BGCOLOR="#E2E8F0"><B>TableSession</B></TD></TR>
<TR><TD ALIGN="LEFT">+sessionId: UUID<BR ALIGN="LEFT"/>+guestCount: int<BR ALIGN="LEFT"/>+status: TableSessionStatus</TD></TR>
<TR><TD ALIGN="LEFT"> </TD></TR>
</TABLE>>];
  "Order" -> "OrderItem" [taillabel="1", headlabel="1..*", arrowtail=diamond, dir=both, arrowhead=vee];
  "OrderItem" -> "ModifierSelection" [taillabel="1", headlabel="0..*", arrowtail=diamond, dir=both, arrowhead=vee];
  "OrderItem" -> "MenuItem" [taillabel="*", headlabel="1"];
  "Order" -> "TableSession" [taillabel="1", headlabel="1"];
  "Order" -> "KitchenTicket" [taillabel="1", headlabel="1..*"];
  "KitchenTicket" -> "KitchenTicketItem" [taillabel="1", headlabel="1..*", arrowtail=diamond, dir=both, arrowhead=vee];
  "KitchenTicketItem" -> "OrderItem" [taillabel="*", headlabel="1"];
  "KitchenTicket" -> "KitchenPriorityPolicy" [style=dashed];
}
