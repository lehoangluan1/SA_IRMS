digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.65, ranksep=0.9, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Ordering and Kitchen Collaboration"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  OrdersController [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>OrdersController</B></TD></TR>

      <TR><TD ALIGN="LEFT">- ordersService: OrdersService<BR ALIGN="LEFT"/>- permissionGuard: PermissionGuard</TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(body, request)<BR ALIGN="LEFT"/>+ confirmDraftOrder(orderId, request)<BR ALIGN="LEFT"/>+ cancelItem(orderItemId, body, request)</TD></TR>

    </TABLE>

  >];
  OrdersService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrdersService</B></TD></TR>
      <TR><TD ALIGN="LEFT">- creationService: OrderCreationService<BR ALIGN="LEFT"/>- confirmationService: OrderDraftConfirmationService<BR ALIGN="LEFT"/>- orderItemWorkflowService: OrderItemWorkflowService</TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(request, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ confirmDraftOrder(orderId, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ markServed(orderItemId, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderCreationService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrderCreationService</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(request, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderDraftConfirmationService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrderDraftConfirmationService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ confirmDraftOrder(orderId, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderItemWorkflowService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>OrderItemWorkflowService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ markServed(orderItemId, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ sendDelayedItem(orderItemId, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ cancelOrderItem(orderItemId, reason, actor, correlationId, metadata)</TD></TR>
    </TABLE>
  >];
  OrderRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>OrderRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createOrder(...)<BR ALIGN="LEFT"/>+ confirmDraftOrder(...)<BR ALIGN="LEFT"/>+ updateOrderStatus(...)</TD></TR>
    </TABLE>
  >];
  OrderQueryRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>OrderQueryRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ loadDraftOrder(orderId)<BR ALIGN="LEFT"/>+ loadOrderItemRouting(orderItemId)<BR ALIGN="LEFT"/>+ loadOrderState(orderId)</TD></TR>
    </TABLE>
  >];
  RemoteKitchenOrderRoutingClient [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;adapter&gt;&gt;</I><BR/><B>RemoteKitchenOrderRoutingClient</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ queueConfirmedItems(orderId, items, notes)<BR ALIGN="LEFT"/>+ holdOrderItemForService(orderItemId)<BR ALIGN="LEFT"/>+ releaseHeldOrderItem(orderId, item, notes)</TD></TR>
    </TABLE>
  >];
  KitchenCoordinationPort [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>KitchenCoordinationPort</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ queueConfirmedItems(orderId, items, notes)<BR ALIGN="LEFT"/>+ holdOrderItemForService(orderItemId)<BR ALIGN="LEFT"/>+ blockOrderItem(orderItemId, reason)</TD></TR>
    </TABLE>
  >];

  KitchenIntegrationController [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>KitchenIntegrationController</B></TD></TR>

      <TR><TD ALIGN="LEFT">- routingService: KitchenOrderRoutingService</TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ queueConfirmedItems(orderId, request)<BR ALIGN="LEFT"/>+ holdOrderItemForService(orderItemId)<BR ALIGN="LEFT"/>+ releaseHeldOrderItem(orderId, request)</TD></TR>

    </TABLE>

  >];
  KitchenOrderRoutingService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenOrderRoutingService</B></TD></TR>
      <TR><TD ALIGN="LEFT">- routingRepository: KitchenOrderRoutingRepository</TD></TR>
      <TR><TD ALIGN="LEFT">+ queueConfirmedItems(orderId, items, notes)<BR ALIGN="LEFT"/>+ holdOrderItemForService(orderItemId)<BR ALIGN="LEFT"/>+ releaseHeldOrderItem(orderId, item, notes)</TD></TR>
    </TABLE>
  >];
  KitchenTicketItemWorkflowService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenTicketItemWorkflowService</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ moveItemToCooking(ticketItemId, actorUserId, correlationId)<BR ALIGN="LEFT"/>+ markItemReady(ticketItemId, correlationId)<BR ALIGN="LEFT"/>+ blockItem(ticketItemId, reason, correlationId)</TD></TR>
    </TABLE>
  >];
  KitchenOrderRoutingRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>KitchenOrderRoutingRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createRoutePlan(orderId, notes)<BR ALIGN="LEFT"/>+ createTicket(orderId, routePlanId, stationId)<BR ALIGN="LEFT"/>+ createTicketItem(ticketId, item)</TD></TR>
    </TABLE>
  >];

  OrdersController -> OrdersService [arrowhead=none];
  OrdersService -> OrderCreationService [arrowhead=none];
  OrdersService -> OrderDraftConfirmationService [arrowhead=none];
  OrdersService -> OrderItemWorkflowService [arrowhead=none];
  OrderCreationService -> OrderRepository [style=dashed, arrowhead=open];
  OrderDraftConfirmationService -> OrderRepository [style=dashed, arrowhead=open];
  OrderDraftConfirmationService -> OrderQueryRepository [style=dashed, arrowhead=open];
  OrderDraftConfirmationService -> KitchenCoordinationPort [style=dashed, arrowhead=open];
  RemoteKitchenOrderRoutingClient -> KitchenCoordinationPort [style=dashed, arrowhead=empty];
  RemoteKitchenOrderRoutingClient -> KitchenIntegrationController [style=dashed, arrowhead=open];
  KitchenIntegrationController -> KitchenOrderRoutingService [arrowhead=none];
  KitchenOrderRoutingService -> KitchenOrderRoutingRepository [style=dashed, arrowhead=open];
  KitchenTicketItemWorkflowService -> KitchenOrderRoutingRepository [style=dashed, arrowhead=open];
}
