digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.65, ranksep=0.9, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Billing, Inventory and Governance Extension Points"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  BillingService [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>BillingService</B></TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>

      <TR><TD ALIGN="LEFT">+ createBill(tableSessionId)<BR ALIGN="LEFT"/>+ splitBill(billId, request)<BR ALIGN="LEFT"/>+ processPayment(billId, request, actor)<BR ALIGN="LEFT"/>+ refundPayment(paymentId, request, actor, correlationId, metadata)</TD></TR>

    </TABLE>

  >];
  BillingPaymentService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>BillingPaymentService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ processPayment(billId, request, actor)</TD></TR>
    </TABLE>
  >];
  PaymentGateway [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>PaymentGateway</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ supports(method)<BR ALIGN="LEFT"/>+ authorize(method, amount, amountReceived, paymentId)<BR ALIGN="LEFT"/>+ refund(payment, amount, refundId)</TD></TR>
    </TABLE>
  >];
  CashPaymentGateway [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;adapter&gt;&gt;</I><BR/><B>CashPaymentGateway</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ supports(method)<BR ALIGN="LEFT"/>+ authorize(...)<BR ALIGN="LEFT"/>+ refund(...)</TD></TR>
    </TABLE>
  >];
  ExternalReferencePaymentGateway [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;adapter&gt;&gt;</I><BR/><B>ExternalReferencePaymentGateway</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ supports(method)<BR ALIGN="LEFT"/>+ authorize(...)<BR ALIGN="LEFT"/>+ refund(...)</TD></TR>
    </TABLE>
  >];

  InventoryService [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>InventoryService</B></TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>

      <TR><TD ALIGN="LEFT">+ load()<BR ALIGN="LEFT"/>+ createIngredient(request)<BR ALIGN="LEFT"/>+ updateIngredient(inventoryItemId, request, actorUserId, metadata)<BR ALIGN="LEFT"/>+ consumeForKitchenStart(orderItemId, actorUserId, correlationId)</TD></TR>

    </TABLE>

  >];
  InventoryStockService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>InventoryStockService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ recordManualAdjustment(inventoryItemId, delta, actorUserId, correlationId)<BR ALIGN="LEFT"/>+ consumeForKitchenStart(orderItemId, actorUserId, correlationId)</TD></TR>
    </TABLE>
  >];
  LowStockSeverityPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>LowStockSeverityPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ alertSeverity(current, minimum)<BR ALIGN="LEFT"/>+ notificationPriority(current, minimum)</TD></TR>
    </TABLE>
  >];
  UsageBasedReorderRecommendationStrategy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;strategy&gt;&gt;</I><BR/><B>UsageBasedReorderRecommendationStrategy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ compute(stockLevel)</TD></TR>
    </TABLE>
  >];

  AuthService [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>AuthService</B></TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>

      <TR><TD ALIGN="LEFT">+ login(email, password, requestedRole, deviceId, ipAddress)<BR ALIGN="LEFT"/>+ logout(user)<BR ALIGN="LEFT"/>+ currentUser(user)</TD></TR>

    </TABLE>

  >];
  AuditService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>AuditService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ record(...)<BR ALIGN="LEFT"/>+ search(searchTerm, actionFilter, actorRole, startDate, endDate, limit, viewer)<BR ALIGN="LEFT"/>+ exportCsv(auditRows)</TD></TR>
    </TABLE>
  >];
  AuditEventMaterializer [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>AuditEventMaterializer</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ record(envelope)</TD></TR>
    </TABLE>
  >];
  IdentityRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;repository&gt;&gt;</I><BR/><B>IdentityRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ findUserAccountByEmail(email)<BR ALIGN="LEFT"/>+ findActiveSessionByTokenHash(tokenHash)<BR ALIGN="LEFT"/>+ createSession(...)</TD></TR>
    </TABLE>
  >];

  BillingService -> BillingPaymentService [arrowhead=none];
  BillingPaymentService -> PaymentGateway [style=dashed, arrowhead=open];
  CashPaymentGateway -> PaymentGateway [style=dashed, arrowhead=empty];
  ExternalReferencePaymentGateway -> PaymentGateway [style=dashed, arrowhead=empty];
  InventoryService -> InventoryStockService [arrowhead=none];
  InventoryStockService -> LowStockSeverityPolicy [style=dashed, arrowhead=open];
  InventoryStockService -> UsageBasedReorderRecommendationStrategy [style=dashed, arrowhead=open];
  AuthService -> IdentityRepository [style=dashed, arrowhead=open];
  AuditService -> IdentityRepository [style=dashed, arrowhead=open];
  AuditEventMaterializer -> IdentityRepository [style=dashed, arrowhead=open];
}
