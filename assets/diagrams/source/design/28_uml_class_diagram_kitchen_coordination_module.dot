digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.65, ranksep=0.9, splines=polyline, fontname="Arial", labelloc="t", label="UML Class Diagram - Kitchen Coordination Module Structure"];
  node [shape=plain, fontname="Arial", fontsize=9];
  edge [color="#64748B", fontname="Arial", fontsize=8.5, arrowsize=0.7];

  KitchenController [label=<

    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">

      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;controller&gt;&gt;</I><BR/><B>KitchenController</B></TD></TR>

      <TR><TD ALIGN="LEFT">- kitchenService: KitchenService</TD></TR>

      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ overview(station, request)<BR ALIGN="LEFT"/>+ updateTicketStatus(ticketId, body, request)<BR ALIGN="LEFT"/>+ updateItemStatus(ticketItemId, body, request)<BR ALIGN="LEFT"/>+ serveTicket(ticketId, request)</TD></TR>

    </TABLE>

  >];
  KitchenService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenService</B></TD></TR>
      <TR><TD ALIGN="LEFT">+ load(stationFilter)<BR ALIGN="LEFT"/>+ updateTicketStatus(ticketId, targetStatus, actor, correlationId)<BR ALIGN="LEFT"/>+ updateItemStatus(ticketItemId, targetStatus, reason, actor, correlationId, metadata)<BR ALIGN="LEFT"/>+ serveTicket(ticketId, actor, correlationId)</TD></TR>
    </TABLE>
  >];
  KitchenOrderRoutingService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenOrderRoutingService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ queueConfirmedItems(orderId, items, notes)<BR ALIGN="LEFT"/>+ holdOrderItemForService(orderItemId)<BR ALIGN="LEFT"/>+ releaseHeldOrderItem(orderId, item, notes)</TD></TR>
    </TABLE>
  >];
  KitchenTicketItemWorkflowService [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;service&gt;&gt;</I><BR/><B>KitchenTicketItemWorkflowService</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ moveItemToCooking(ticketItemId, actorUserId, correlationId)<BR ALIGN="LEFT"/>+ markItemReady(ticketItemId, correlationId)<BR ALIGN="LEFT"/>+ markInventoryDeducted(ticketItemId)</TD></TR>
    </TABLE>
  >];
  KitchenWorkflowMediator [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;workflow&gt;&gt;</I><BR/><B>KitchenWorkflowMediator</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ handleDishStatusChanged(envelope)<BR ALIGN="LEFT"/>+ transitionTicket(ticketId, currentState, targetState, event, payload)<BR ALIGN="LEFT"/>+ calculateDeadline(preparationMinutes, itemCount, priority, peakHour)</TD></TR>
    </TABLE>
  >];
  KitchenStatusPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>KitchenStatusPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ normalize(status)<BR ALIGN="LEFT"/>+ ensureValidTicketTransition(currentStatus, targetStatus, everyItemReady)<BR ALIGN="LEFT"/>+ deriveTicketStatus(itemStatuses)</TD></TR>
    </TABLE>
  >];
  KitchenPriorityPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>KitchenPriorityPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ nextManualPriority(currentPriority)<BR ALIGN="LEFT"/>+ score(priorityLabel)<BR ALIGN="LEFT"/>+ automaticEscalation(currentPriority, targetServiceAt, rushCutoff, expediteCutoff)</TD></TR>
    </TABLE>
  >];
  KitchenTicketTransitionPolicy [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;policy&gt;&gt;</I><BR/><B>KitchenTicketTransitionPolicy</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ ensureValidTransition(currentState, targetState)<BR ALIGN="LEFT"/>+ toPersistentStatus(state)</TD></TR>
    </TABLE>
  >];
  KitchenOrderRoutingRepository [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>KitchenOrderRoutingRepository</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ createRoutePlan(orderId, notes)<BR ALIGN="LEFT"/>+ createTicket(orderId, routePlanId, stationId)<BR ALIGN="LEFT"/>+ createTicketItem(ticketId, item)</TD></TR>
    </TABLE>
  >];
  KitchenTicketItemCommandPort [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>KitchenTicketItemCommandPort</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ moveItemToCooking(ticketItemId, nextActionAt)<BR ALIGN="LEFT"/>+ markItemReady(ticketItemId)<BR ALIGN="LEFT"/>+ blockItem(ticketItemId, reason)</TD></TR>
    </TABLE>
  >];
  OrderingStatusSyncPort [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;interface&gt;&gt;</I><BR/><B>OrderingStatusSyncPort</B></TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
      <TR><TD ALIGN="LEFT">+ refreshOrder(orderId)<BR ALIGN="LEFT"/>+ applyKitchenLineStatuses(orderId, lineStatuses)</TD></TR>
    </TABLE>
  >];
  RemoteOrderStateUpdateClient [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;adapter&gt;&gt;</I><BR/><B>RemoteOrderStateUpdateClient</B></TD></TR>
      <TR><TD ALIGN="LEFT">implements OrderingStatusSyncPort</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];
  KitchenViews [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#475569">
      <TR><TD BGCOLOR="#F1F5F9"><I>&lt;&lt;view records&gt;&gt;</I><BR/><B>KitchenViews</B></TD></TR>
      <TR><TD ALIGN="LEFT">KitchenOverview<BR ALIGN="LEFT"/>TicketView<BR ALIGN="LEFT"/>TicketItemView</TD></TR>
      <TR><TD ALIGN="LEFT">&nbsp;</TD></TR>
    </TABLE>
  >];

  KitchenController -> KitchenService [arrowhead=none];
  KitchenService -> KitchenTicketItemWorkflowService [arrowhead=none];
  KitchenService -> KitchenStatusPolicy [style=dashed, arrowhead=open];
  KitchenService -> KitchenPriorityPolicy [style=dashed, arrowhead=open];
  KitchenOrderRoutingService -> KitchenOrderRoutingRepository [style=dashed, arrowhead=open];
  KitchenTicketItemWorkflowService -> KitchenTicketItemCommandPort [style=dashed, arrowhead=open];
  KitchenWorkflowMediator -> KitchenTicketTransitionPolicy [style=dashed, arrowhead=open];
  KitchenWorkflowMediator -> OrderingStatusSyncPort [style=dashed, arrowhead=open];
  RemoteOrderStateUpdateClient -> OrderingStatusSyncPort [style=dashed, arrowhead=empty];
  KitchenService -> KitchenViews [style=dashed, arrowhead=open];
}
