    n3 [label="Thêm / bỏ vai trò
hoặc quyền nhạy cảm", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n0 -> n1 -> n3 [style=invis, weight=20];
  }
  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="Hệ thống IRMS"; fontsize=14; labelloc="t"; labeljust="l";
