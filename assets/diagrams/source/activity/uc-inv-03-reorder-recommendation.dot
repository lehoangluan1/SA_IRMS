digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-INV-03 -- Analyze Consumption and Recommend Reorder";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Manager / Stock Manager"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open reorder analysis\nscreen", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Choose analysis window,\nbranch, and ingredient group", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Review and adjust the\nrecommendation if needed", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Load consumption history,\nlow-stock signals, waste, and lead time", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Historical data reliable enough?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Apply default min-max rules\nand safety stock", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Calculate average usage,\nshift variation, and stock-out risk", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Generate recommended reorder quantity,\nreorder point, and target stock", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Abnormal data or\nunit mismatch?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Flag confidence level and\nrequest manual review", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Store snapshot or\nexport reorder report", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n6 [xlabel="[yes]"];
  n3 -> n4 [xlabel="[no]"];
  n4 -> n5;
  n5 -> n6;
  n6 -> n7;
  n7 -> n8;
  n8 -> n9 [xlabel="[yes]"];
  n8 -> n10 [xlabel="[no]"];
  n9 -> n10;
  n10 -> n11;
  n11 -> n12;
}
