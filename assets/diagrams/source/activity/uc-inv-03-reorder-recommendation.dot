digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-INV-03 -- Phân tích tiêu hao và đề xuất nhập hàng";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Quản lý / Quản lý kho"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Mở màn hình phân tích\nnhập hàng", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Chọn kỳ phân tích,\nchi nhánh và nhóm nguyên liệu", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Rà soát và điều chỉnh\nđề xuất nếu cần", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="Hệ thống IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Tải lịch sử tiêu hao,\nlow-stock, waste và lead time", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Dữ liệu lịch sử đủ tin cậy?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Áp dụng quy tắc min-max\nvà safety stock mặc định", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Tính tiêu hao bình quân,\nbiến động theo ca và rủi ro thiếu hàng", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Sinh lượng nhập khuyến nghị,\nđiểm đặt lại hàng và tồn mục tiêu", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Có dữ liệu bất thường\nhoặc lệch đơn vị tính?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Đánh dấu mức tin cậy,\nyêu cầu rà soát thủ công", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Lưu snapshot hoặc\nxuất báo cáo đề xuất nhập hàng", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n6 [xlabel="Có"];
  n3 -> n4 [xlabel="Không"];
  n4 -> n5;
  n5 -> n6;
  n6 -> n7;
  n7 -> n8;
  n8 -> n9 [xlabel="Có"];
  n8 -> n10 [xlabel="Không"];
  n9 -> n10;
  n10 -> n11;
  n11 -> n12;
}
