digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-ORD-03 — Gửi đơn gọi món sang bếp";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Phục vụ";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Chọn các dòng món cần gửi\nxuống bếp", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n2 [label="Đánh dấu món phục vụ sau\nnếu có", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n0 -> n1 -> n2 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="Hệ thống IRMS";
    n3 [label="Kiểm tra trạng thái đơn gọi món,\ndòng món chưa gửi và quyền gửi", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Có dòng món hợp lệ để gửi?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n5 [label="Tách nhóm gửi ngay và nhóm\nphục vụ sau", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Kiểm tra quy tắc định tuyến\ntrạm bếp của từng món", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Định tuyến hợp lệ?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n8 [label="Màn hình bếp khả dụng?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Tạo KitchenTicket theo trạm,\nưu tiên và hạn phục vụ", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Lưu dấu thời gian gửi và cập nhật\ntrạng thái đơn gọi món", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Đưa yêu cầu vào hàng chờ gửi lại\nvà cảnh báo phục vụ", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [label="Chặn gửi và báo lỗi cấu hình\nthực đơn hoặc trạm bếp", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n3 -> n4 -> n5 -> n6 -> n7 -> n8 -> n9 -> n10 -> n11 -> n12 -> n13 [style=invis, weight=20];
  }

  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB";
    label="Màn hình bếp";
    n14 [label="Hiển thị phiếu mới,\nphát cảnh báo và xếp hàng", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n15 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n14 -> n15 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5 [xlabel="Có"];
  n4 -> n13 [xlabel="Không"];
  n5 -> n6;
  n6 -> n7;
  n7 -> n8 [xlabel="Có"];
  n7 -> n12 [xlabel="Không"];
  n8 -> n9 [xlabel="Có"];
  n8 -> n11 [xlabel="Không"];
  n9 -> n10;
  n10 -> n14;
  n14 -> n15;
  n11 -> n13;
  n12 -> n13;
}
