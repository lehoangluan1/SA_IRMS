digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-ADM-03 -- Review Audit Log and Trace Sensitive Actions";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Manager / Administrator"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open the audit log screen", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Enter filters:\ntime, actor,\nentity, action", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Open record details and\nreview before/after plus reason", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Choose export report or\nflag follow-up", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Permission to access\nsensitive logs?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Query immutable audit log,\nload correlation ID and related objects", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Matching records found?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n6 [label="Show no results or\noverly narrow filter", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Mask sensitive fields and\nsort by time", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n9 [label="Write audit trail for\nview or export", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3 [xlabel="[yes]"];
  n2 -> n11 [xlabel="[no]"];
  n3 -> n4;
  n4 -> n5;
  n5 -> n8 [xlabel="[yes]"];
  n5 -> n6 [xlabel="[no]"];
  n6 -> n11;
  n8 -> n7;
  n7 -> n10;
  n10 -> n9;
  n9 -> n11;
}
