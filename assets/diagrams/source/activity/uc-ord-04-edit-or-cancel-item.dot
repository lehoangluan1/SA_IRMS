digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-ORD-04 -- Edit or Cancel Order Item";
  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Server"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Select the order item to\nedit or cancel", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n4 [label="Edit freely before send", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n6 [label="Enter edit or cancel reason", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n0 -> n1 -> n4 -> n6 [style=invis, weight=20];
  }
  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n2 [label="Show status and\nallowed actions", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n3 [label="Item already sent to kitchen?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n5 [label="Update order and\nrecalculate running total", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n7 [label="Manager approval\nrequired?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n10 [label="Update order and\npublish kitchen change event", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n12 [label="Reject the action", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n2 -> n3 -> n5 -> n7 -> n10 -> n12 [style=invis, weight=20];
  }
  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#FDECEC"; color="#BBBBBB"; penwidth=1.0;
    label="Manager"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n8 [label="Review approval request", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n9 [label="Approve?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n8 -> n9 [style=invis, weight=20];
  }
  subgraph cluster_l4 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB"; penwidth=1.0;
    label="Kitchen / KDS"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n11 [label="Adjust kitchen ticket or\nstop preparation", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n13 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n11 -> n13 [style=invis, weight=20];
  }
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4 [xlabel="[no]"];
  n3 -> n6 [xlabel="[yes]"];
  n4 -> n5;
  n5 -> n13;
  n6 -> n7;
  n7 -> n10 [xlabel="[no]"];
  n7 -> n8 [xlabel="[yes]"];
  n8 -> n9;
  n9 -> n10 [xlabel="[yes]"];
  n9 -> n12 [xlabel="[no]"];
