digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-RES-04 -- Update Table Status and Release Table";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Host / Server / Cashier"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Select table or table session\nto update", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Choose target status:\nCleaning / Available / OutOfService", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [label="Confirm table cleanup complete", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Load table status,\nTableSession, and related bill", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Open service session or\nopen bill exists?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Check outstanding balance and\nunsettled bill splits", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Goal is to release the table?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n7 [label="Allow session close\nand switch to Cleaning?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n8 [label="Reject table release and\nrequest settlement first", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n9 [label="Close TableSession and\nset status to Cleaning", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Update another status\nand store reason", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [label="Switch table to Available\nand refresh floor plan", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [label="Matching waitlist guest exists?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n15 [label="Write audit trail and\ntimestamp", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l3 {
    style="rounded,filled"; fillcolor="#EAFBF1"; color="#BBBBBB"; penwidth=1.0;
    label="Waitlist / Dispatch"; fontsize=14; labelloc="t"; labeljust="l";
    n16 [label="Suggest next guest call\nor refresh ETA", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n17 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4 [xlabel="Yes"];
  n3 -> n5 [xlabel="No"];
  n4 -> n5;
  n5 -> n6;
  n6 -> n7 [xlabel="Yes"];
  n6 -> n10 [xlabel="No"];
  n7 -> n9 [xlabel="Yes"];
  n7 -> n8 [xlabel="No"];
  n8 -> n17;
  n9 -> n12;
  n12 -> n13;
  n10 -> n15;
  n13 -> n14;
  n14 -> n16 [xlabel="Yes"];
  n14 -> n15 [xlabel="No"];
  n16 -> n15;
  n15 -> n17;
}
