digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-INV-01 -- Update Stock Consumption After Service";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="IRMS";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Consume served-item event or\nmanual adjustment request", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n2 [label="Manual adjustment?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Load RecipeLine for each\nserved item", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Recipe mapping available?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n6 [label="Calculate ingredient usage\nfrom served quantities", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Create StockTransaction per\ningredient and update on-hand stock", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="On-hand stock below\nalert threshold?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Publish InventoryLow", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Abnormal negative stock?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n11 [label="Create configuration alert or\nwait for manual review", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n0 -> n1 -> n2 -> n4 -> n5 -> n6 -> n7 -> n8 -> n9 -> n10 -> n11 -> n12 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Warehouse Manager";
    n3 [label="Enter adjustment quantity\nand normalized reason", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [label="Review negative stock cause\nor abnormal data", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n3 -> n13 -> n14 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3 [xlabel="[yes]"];
  n2 -> n4 [xlabel="[no]"];
  n3 -> n7;
  n4 -> n5;
  n5 -> n6 [xlabel="[yes]"];
  n5 -> n11 [xlabel="[no]"];
  n6 -> n7;
  n7 -> n8;
  n8 -> n9 [xlabel="[yes]"];
  n8 -> n10 [xlabel="[no]"];
  n9 -> n10;
  n10 -> n13 [xlabel="[yes]"];
  n10 -> n12 [xlabel="[no]"];
  n11 -> n12;
  n13 -> n14;
}
