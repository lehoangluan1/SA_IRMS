digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-ORD-01 -- Create Table Order";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Server";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open table session and choose\nthe create order action", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Select items, quantities,\nand service notes", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Open item customization\nstep?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n6 [label="Choose modifiers and notes\nfor each item", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n9 [label="Add another item?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n10 [label="Choose save draft or\nconfirm order", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n0 -> n1 -> n4 -> n5 -> n6 -> n9 -> n10 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="IRMS";
    n2 [label="Check permissions\nand TableSession status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Table session active?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n7 [label="Load menu, suggestions,\nand current availability", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Item available and\nselectable?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n11 [label="Calculate running total from\ncurrent prices and quantities", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [label="Save order in draft status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [label="Confirm order and\nfreeze price snapshot", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [label="Block action and request\nthe table session be reopened", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n15 [label="Block item, suggest replacement,\nor return to selection", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n16 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n2 -> n3 -> n7 -> n8 -> n11 -> n12 -> n13 -> n14 -> n15 -> n16 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n7 [xlabel="Yes"];
  n3 -> n14 [xlabel="No"];
  n7 -> n4;
  n4 -> n5;
  n5 -> n6 [xlabel="Yes"];
  n5 -> n8 [xlabel="No"];
  n6 -> n8;
  n8 -> n11 [xlabel="Yes"];
  n8 -> n15 [xlabel="No"];
  n15 -> n4;
  n11 -> n9;
  n9 -> n4 [xlabel="Yes"];
  n9 -> n10 [xlabel="No"];
  n10 -> n12;
  n10 -> n13;
  n12 -> n16;
  n13 -> n16;
  n14 -> n16;
}
