digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-RES-03 -- Manage Waitlist";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Host"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Enter customer details,\nparty size, and contact channel", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Confirm add to waitlist", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Select customer to call", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Continue to the guest check-in\nand seating use case", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Estimate waiting time", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Create waitlist record", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Listen for table release events", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Suitable table available?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n7 [label="Match by capacity,\nzone, and priority", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Customer responds within the window?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n12 [label="Mark as skipped or\nupdate queue position", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l3 {
    style="rounded,filled"; fillcolor="#EAFBF1"; color="#BBBBBB"; penwidth=1.0;
    label="Notification Service"; fontsize=14; labelloc="t"; labeljust="l";
    n9 [label="Queue waitlist hold notice", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6;
  n6 -> n7 [xlabel="[yes]"];
  n6 -> n5 [xlabel="[no]"];
  n7 -> n8;
  n8 -> n9;
  n9 -> n10;
  n10 -> n11 [xlabel="[yes]"];
  n10 -> n12 [xlabel="[no]"];
  n11 -> n13;
  n12 -> n13;
}
