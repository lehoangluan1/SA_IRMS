digraph G {
  charset="UTF-8";
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.68, pad=0.25, dpi=170, bgcolor="white", fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="Arial"; label="UC-KIT-03 -- Prioritize Kitchen Queue and Expedite Item";

  subgraph cluster_l1 {
    style="rounded,filled"; fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Kitchen / Manager"; fontsize=14; labelloc="t"; labeljust="l";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open station queue or\nreceive an expedite alert", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Select the ticket or item\nto prioritize", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Enter reason:\nVIP, near SLA,\ncourse coordination", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l2 {
    style="rounded,filled"; fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    n2 [label="Show SLA, priority,\ndelay, and station status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Near deadline ticket or\nexpedite request exists?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n4 [label="Apply priority policy:\nSLA, VIP, course dependency", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Operator allowed to\nchange priority?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n7 [label="Require manager confirmation\nor keep original order", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n9 [label="Update priority and\nreorder the queue", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Write audit trail and expedite timestamp", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
  }

  subgraph cluster_l3 {
    style="rounded,filled"; fillcolor="#EAFBF1"; color="#BBBBBB"; penwidth=1.0;
    label="KDS"; fontsize=14; labelloc="t"; labeljust="l";
    n11 [label="Refresh display order and\nflag expedited ticket", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4 [xlabel="[yes]"];
  n3 -> n12 [xlabel="[no]"];
  n4 -> n5;
  n5 -> n6;
  n6 -> n8 [xlabel="[yes]"];
  n6 -> n7 [xlabel="[no]"];
  n7 -> n12;
  n8 -> n9;
  n9 -> n10;
  n10 -> n11;
  n11 -> n12;
}
