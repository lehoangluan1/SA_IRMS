digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-KIT-01 -- Update Cooking Progress";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Kitchen";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open waiting kitchen ticket", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Mark preparation started", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Update each item to\nin preparation", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Ingredient shortage or\noperational blocker?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Mark item ready", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n0 -> n1 -> n3 -> n5 -> n7 -> n9 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="IRMS";
    n2 [label="Check responsible station\nand current ticket status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Record start timestamp and\ncompare with service target", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n6 [label="Need escalation or\nblocker review?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n8 [label="Mark blocked, create alert,\nand store reason", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="All items in the ticket\nready?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n11 [label="Mark KitchenTicket ready\nand store completion time", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n2 -> n4 -> n6 -> n8 -> n10 -> n11 -> n12 [style=invis, weight=20];
  }

  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB";
    label="Server Device";
    n13 [label="Receive item ready notification\nand prepare table delivery", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n13 -> n14 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6;
  n6 -> n7 [xlabel="Yes or pending"];
  n7 -> n8 [xlabel="Yes"];
  n7 -> n9 [xlabel="No"];
  n8 -> n12;
  n9 -> n10;
  n10 -> n5 [xlabel="No"];
  n10 -> n11 [xlabel="Yes"];
  n11 -> n13;
  n13 -> n14;
}
