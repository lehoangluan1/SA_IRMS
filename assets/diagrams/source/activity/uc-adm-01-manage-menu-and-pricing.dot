    n4 [label="Kiểm tra dữ liệu bắt
buộc và lịch hiệu
lực", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n5 [label="Publish được?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n7 [label="Phát hành version
