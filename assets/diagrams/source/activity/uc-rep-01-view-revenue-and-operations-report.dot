    n8 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n7 -> n8 [style=invis, weight=20];
  }
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n5 [xlabel="Có"];
