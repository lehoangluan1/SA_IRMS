    rank=same;
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Chọn thời gian, chi
nhánh và bộ lọc", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n6 [label="Xuất PDF / CSV?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n0 -> n1 -> n6 [style=invis, weight=20];
  }
  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="Reporting Engine / IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n2 [label="Tải ReportSnapshot
hoặc aggregate mới
nhất", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n3 [label="Khối lượng truy vấn
lớn?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n4 [label="Hiển thị dashboard
và drill-down", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n5 [label="Chạy truy vấn bất
đồng bộ và báo thời
điểm sẵn sàng", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n2 -> n3 -> n4 -> n5 [style=invis, weight=20];
