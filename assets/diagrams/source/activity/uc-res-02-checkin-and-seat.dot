digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-RES-02 -- Check In Guest and Seat Table";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Host";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Find reservation by code,\nphone number, or customer name", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Confirm guest arrival and\nactual party size", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n5 [label="Table change or\ntable merge needed?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n6 [label="Choose replacement table or\ntable group", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n0 -> n1 -> n4 -> n5 -> n6 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="IRMS";
    n2 [label="Load reservation status,\nhold window, and suggested table", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Reservation still valid or\ntable still available?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n7 [label="Check capacity,\ncleaning status, and duplicate assignment", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Replacement table valid?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n9 [label="Open table session\nand update table status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Assign service zone and\npublish TableSessionOpened", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Move guest to the waitlist\nor suggest another table", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n2 -> n3 -> n7 -> n8 -> n9 -> n10 -> n11 -> n14 [style=invis, weight=20];
  }

  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#FDECEC"; color="#BBBBBB";
    label="Manager";
    n12 [label="Review expired hold\nrecovery request", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n13 [label="Approve recovery?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n12 -> n13 [style=invis, weight=20];
  }

  subgraph cluster_l4 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB";
    label="Server";
    n15 [label="Receive new table notification\nand prepare order capture", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n16 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n15 -> n16 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4 [xlabel="[yes]"];
  n3 -> n12 [xlabel="No or expired"];
  n12 -> n13;
  n13 -> n4 [xlabel="[yes]"];
  n13 -> n11 [xlabel="[no]"];
  n4 -> n5;
  n5 -> n6 [xlabel="[yes]"];
  n5 -> n9 [xlabel="[no]"];
  n6 -> n7;
  n7 -> n8;
  n8 -> n9 [xlabel="[yes]"];
  n8 -> n11 [xlabel="[no]"];
  n9 -> n10;
  n10 -> n15;
  n15 -> n16;
  n11 -> n14;
}
