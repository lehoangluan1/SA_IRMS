digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-ORD-02 -- Customize Item and Record Allergy Note";
  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB"; penwidth=1.0;
    label="Server"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Open order item details", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n3 [label="Choose modifiers and\nenter allergy note", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n0 -> n1 -> n3 [style=invis, weight=20];
  }
  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB"; penwidth=1.0;
    label="IRMS"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n2 [label="Show modifiers,\npresets, and\nselection limits", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n4 [label="Validate min / max rules\nand price changes", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n5 [label="Data valid?", shape=diamond, style="filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=11, width=1.2, height=0.7, margin="0.05,0.03"];
    n6 [label="Save OrderItemModifier and\nallergy warning", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n8 [label="Show validation error and\nrequest correction", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n2 -> n4 -> n5 -> n6 -> n8 [style=invis, weight=20];
  }
  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB"; penwidth=1.0;
    label="Kitchen / KDS"; fontsize=14; labelloc="t"; labeljust="l";
    rank=same;
    n7 [label="Receive highlighted note on\nthe kitchen ticket", shape=rect, style="rounded,filled", fillcolor="white", color="#333333", penwidth=1.2, fontsize=12, margin="0.12,0.08"];
    n9 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n7 -> n9 [style=invis, weight=20];
  }
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6 [xlabel="[yes]"];
  n5 -> n8 [xlabel="[no]"];
  n8 -> n3;
  n6 -> n7;
  n7 -> n9;
}
