digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.38, ranksep=0.62, pad=0.25, dpi=170, bgcolor="white", fontname="DejaVu Sans"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#444444", penwidth=1.15, arrowsize=0.75];
  labelloc="t"; labeljust="c"; fontsize=20; fontname="DejaVu Sans"; label="UC-PAY-01 -- Process Payment";

  subgraph cluster_l1 {
    style="rounded,filled";
    fillcolor="#EAF3FF"; color="#BBBBBB";
    label="Cashier";
    n0 [shape=circle, label="", width=0.18, height=0.18, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n1 [label="Select the bill or payment split\nto collect", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n3 [label="Choose payment method", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n8 [label="Enter cash received", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n9 [label="Cash received enough?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n0 -> n1 -> n3 -> n8 -> n9 [style=invis, weight=20];
  }

  subgraph cluster_l2 {
    style="rounded,filled";
    fillcolor="#FFF8DB"; color="#BBBBBB";
    label="IRMS";
    n2 [label="Check outstanding amount,\nbill status, and payment permission", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n4 [label="Electronic payment?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n5 [label="Create transaction request and wait for\nPayment Adapter response", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n10 [label="Calculate change and record\ncash payment", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n11 [label="Capture payment, store reference,\nand update outstanding balance", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n12 [label="Outstanding balance remains?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n13 [label="Keep bill in\npartially paid status", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n14 [label="Close bill and publish\nPaymentCaptured", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n15 [label="Mark failed or\npending review", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n16 [shape=doublecircle, label="", width=0.24, height=0.24, fixedsize=true, style=filled, fillcolor="#222222", color="#222222"];
    n2 -> n4 -> n5 -> n10 -> n11 -> n12 -> n13 -> n14 -> n15 -> n16 [style=invis, weight=20];
  }

  subgraph cluster_l3 {
    style="rounded,filled";
    fillcolor="#EAFBF1"; color="#BBBBBB";
    label="Payment Adapter";
    n6 [label="Authenticate and\ncapture electronic payment", shape=rect, style="rounded,filled", fillcolor="white", color="#333333"];
    n7 [label="Transaction successful?", shape=diamond, style="filled", fillcolor="white", color="#333333"];
    n6 -> n7 [style=invis, weight=20];
  }

  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5 [xlabel="[yes]"];
  n4 -> n8 [xlabel="[no]"];
  n5 -> n6;
  n6 -> n7;
  n7 -> n11 [xlabel="[yes]"];
  n7 -> n15 [xlabel="[no]"];
  n8 -> n9;
  n9 -> n10 [xlabel="[yes]"];
  n9 -> n8 [xlabel="[no]"];
  n10 -> n11;
  n11 -> n12;
  n12 -> n13 [xlabel="[yes]"];
  n12 -> n14 [xlabel="[no]"];
  n13 -> n16;
  n14 -> n16;
  n15 -> n16;
}
