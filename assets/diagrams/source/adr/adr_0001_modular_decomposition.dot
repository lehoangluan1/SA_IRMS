digraph G {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, nodesep=0.45, ranksep=0.7, pad=0.15];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#2563eb", fontname="Arial", fontsize=11, margin="0.10,0.08"];
  edge [color="#334155", arrowsize=0.8, fontname="Arial", fontsize=9];

  scope [label="IRMS scope"];
  reservation [label="Reservation\\nmodule"];
  ordering [label="Ordering\\nmodule"];
  kitchen [label="Kitchen\\nmodule"];
  billing [label="Billing\\nmodule"];
  inventory [label="Inventory\\nmodule"];
  reporting [label="Reporting\\nmodule"];
  identity [label="Identity / Audit\\nmodule"];

  scope -> reservation;
  scope -> ordering;
  scope -> kitchen;
  scope -> billing;
  scope -> inventory;
  scope -> reporting;
  scope -> identity;
}
