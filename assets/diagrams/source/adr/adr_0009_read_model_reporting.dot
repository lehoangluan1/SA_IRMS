digraph G {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, nodesep=0.45, ranksep=0.75, pad=0.15];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#0f766e", fontname="Arial", fontsize=10, margin="0.10,0.08"];
  edge [color="#334155", arrowsize=0.8, fontname="Arial", fontsize=9];

  events [label="Domain events"];
  consumer [label="ReportingProjectionConsumer"];
  projection [label="reporting_*\\nprojection tables"];
  api [label="Reporting API"];
  dashboard [label="Manager dashboard"];
  pg [shape=cylinder, label="PostgreSQL\\nsingle physical DB", fillcolor="#eef2ff", color="#4f46e5"];

  events -> consumer;
  consumer -> projection;
  projection -> pg [dir=none];
  pg -> api;
  api -> dashboard;
}
