digraph G {
  graph [rankdir=LR, bgcolor="transparent", splines=ortho, nodesep=0.45, ranksep=0.75, pad=0.15];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#ea580c", fontname="Arial", fontsize=10, margin="0.10,0.08"];
  edge [color="#334155", arrowsize=0.8, fontname="Arial", fontsize=9];

  relay [label="Outbox relay"];
  rabbit [label="RabbitMQ broker"];
  report [label="ReportingProjectionConsumer"];
  inv [label="InventoryStockChangedConsumer"];
  notify [label="NotificationRequestedConsumer"];
  audit [label="AuditRecordingRequestedConsumer"];

  relay -> rabbit;
  rabbit -> report;
  rabbit -> inv;
  rabbit -> notify;
  rabbit -> audit;
}
