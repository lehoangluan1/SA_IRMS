# Normalize text files to LF by default.
* text=auto eol=lf

# Source, docs, and config
*.md text eol=lf
*.tex text eol=lf
*.dot text eol=lf
*.java text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.gitignore text eol=lf

# Shell / command scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
