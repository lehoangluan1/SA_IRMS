# Mặc định: mọi file text lưu trong repo là LF
* text=auto eol=lf

# Source / docs
*.md   text eol=lf
*.tex  text eol=lf
*.dot  text eol=lf
*.ps1  text eol=crlf
*.gitignore text eol=lf

# Shell / config
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.zip  binary