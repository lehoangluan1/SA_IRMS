SPRING_PROFILES_ACTIVE=docker,api-gateway
IRMS_RUNTIME_MODE=api-gateway
IRMS_RUNTIME_SERVICE=api-gateway
SERVER_PORT=8080
APP_PORT=8080
JAVA_OPTS=

DB_HOST=postgres
DB_PORT=5432
DB_NAME=irms
DB_USER=postgres
DB_USERNAME=postgres
DB_PASSWORD=123456
POSTGRES_PORT=5432
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/irms

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=123456
RABBITMQ_MANAGEMENT_PORT=15672

IRMS_RABBITMQ_ENABLED=true
IRMS_LEGACY_DB_FANOUT_ENABLED=false
IRMS_FLYWAY_ENABLED=false

API_GATEWAY_PORT=8080
ORDERING_SERVICE_PORT=8081
KITCHEN_SERVICE_PORT=8082
BILLING_SERVICE_PORT=8083
RESERVATION_SERVICE_PORT=8084
INVENTORY_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
REPORTING_SERVICE_PORT=8087
IDENTITY_AUDIT_SERVICE_PORT=8088

ORDERING_SERVICE_URL=http://ordering-service:8081
KITCHEN_SERVICE_URL=http://kitchen-service:8082
BILLING_SERVICE_URL=http://billing-service:8083
RESERVATION_SERVICE_URL=http://reservation-service:8084
INVENTORY_SERVICE_URL=http://inventory-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086
REPORTING_SERVICE_URL=http://reporting-service:8087
IDENTITY_SERVICE_URL=http://identity-audit-service:8088

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
APP_SESSION_IDLE_TIMEOUT_MINUTES=15
APP_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
APP_DEMO_PASSWORD=Password123!
APP_RESTAURANT_NAME=IRMS Demo Restaurant
APP_RESTAURANT_TIMEZONE=UTC
APP_RESTAURANT_CURRENCY=USD
APP_REPORT_PROJECTION_REFRESH_SECONDS=120
APP_LOW_STOCK_ALERT_SLA_SECONDS=60

IRMS_ACCESS_TOKEN_LIFETIME_MINUTES=60
IRMS_ACCESS_TOKEN_INTROSPECTION_SECONDS=60
IRMS_SESSION_TOUCH_DEBOUNCE_SECONDS=30
IRMS_RECEIPT_MAIL_FROM=no-reply@irms.local
IRMS_KITCHEN_AUTOMATION_POLL_SECONDS=5
IRMS_KITCHEN_COOKING_TO_READY_SECONDS=180
IRMS_KITCHEN_READY_TO_SERVED_SECONDS=120
IRMS_OUTBOX_POLL_MILLIS=2000
IRMS_OUTBOX_RABBIT_POLL_MILLIS=1000
IRMS_OUTBOX_RABBIT_BATCH_SIZE=50
IRMS_OUTBOX_RABBIT_MAX_RETRIES=8
IRMS_OUTBOX_RABBIT_BASE_BACKOFF_SECONDS=15
IRMS_RABBITMQ_CONSUMER_MAX_RETRIES=5
IRMS_RABBITMQ_PUBLISHER_CONFIRM_TIMEOUT_MILLIS=5000
IRMS_INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
IRMS_ACCESS_TOKEN_SIGNING_SECRET=dev-access-token-signing-secret-change-me

MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
